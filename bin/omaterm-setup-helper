#!/usr/bin/env bash

finish_from_interrupt() {
  exit 130
}

gum_input_into() {
  local -n target="$1"
  local value status
  shift

  set +e
  trap : INT
  value="$(gum input "$@")"
  status=$?
  trap - INT
  set -e

  if (( status != 0 )); then
    target=""
    finish_from_interrupt
  fi

  target="$value"
}

gum_choose_into() {
  local -n target="$1"
  local value status
  shift

  set +e
  trap : INT
  value="$(gum choose "$@")"
  status=$?
  trap - INT
  set -e

  if (( status != 0 )); then
    target=""
    finish_from_interrupt
  fi

  target="$value"
}
