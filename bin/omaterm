#!/usr/bin/env bash
set -euo pipefail

IMAGE="${OMATERM_IMAGE:-ghcr.io/omacom-io/omaterm}"
DEFAULT_NAME="omaterm"
LABEL="omaterm=1"
PREPARE_DONE_MARKER="/home/omaterm/.local/state/omaterm/prepare-done"
SETUP_DONE_MARKER="/home/omaterm/.local/state/omaterm/setup-done"
TAILSCALE_STATE_FILE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_HOSTNAME_FILE="/home/omaterm/.local/state/omaterm/tailscale-hostname"
CLONE_IMAGE_REPO="omaterm-clone"

# Resource limits. The host keeps a reserved slice for itself; the rest is
# divided across all Omaterms. CPU is shared dynamically with cpu-shares over
# the cores not reserved for the host (full box when one runs alone, fair split
# under contention). Memory is hard-partitioned evenly by Omaterm count, since
# memory can't degrade gracefully the way CPU does. Set OMATERM_NO_LIMITS=1 to
# opt out entirely.
HOST_RESERVE_CORES="${OMATERM_HOST_RESERVE_CORES:-1}"
HOST_RESERVE_RAM_MB="${OMATERM_HOST_RESERVE_RAM_MB:-2048}"
CPU_SHARES="${OMATERM_CPU_SHARES:-1024}"

usage() {
  cat >&2 <<'EOF'
Usage:
  omaterm
  omaterm new NAME [-c|--clone SOURCE] [-d|--docker-access]
    [-p|--prepare COMMAND] [--op ITEM]
    [--git-name NAME] [--git-email EMAIL] [--gh-token TOKEN]
    [--ts-token TOKEN] [--ts-host HOSTNAME] [--op-token TOKEN]
    [--ssh-key PUBLIC_KEY]
  omaterm connect [NAME]
  omaterm ls
  omaterm exec NAME [-w|--workdir DIR] COMMAND...
  omaterm rm [-a|NAME]
EOF
}

validate_name() {
  local name="$1"

  if [[ ! $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
    echo "Invalid Omaterm name: $name" >&2
    echo "Use letters, numbers, dots, underscores, and hyphens." >&2
    exit 2
  fi
}

omaterm_names() {
  docker container ls -a --filter "label=$LABEL" --format '{{.Names}}' | sort -u
}

container_exists() {
  docker container inspect "$1" >/dev/null 2>&1
}

container_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$1")" == "true" ]]
}

# The docker socket is group-owned by `docker`. After the installer adds the
# user to that group, shells started earlier still lack the GID until they
# re-login, so docker calls fail with a permission error. If the user is a
# member per /etc/group but this process didn't inherit the GID, re-exec under
# the group with sg so omaterm works without a logout. The GID check is the
# fast path: when it's already present (the normal case) we return immediately
# without touching docker.
ensure_docker_group() {
  local docker_gid
  docker_gid="$(getent group docker | cut -d: -f3)"

  [[ -n $docker_gid ]] || return 0
  id -G | grep -qw "$docker_gid" && return 0   # already have it: nothing to do
  id -nG | grep -qw docker || return 0         # not a member: can't fix it here
  command -v sg >/dev/null 2>&1 || return 0    # no sg: fall through to the real error
  docker info >/dev/null 2>&1 && return 0      # reachable anyway: don't re-exec

  exec sg docker -c "$(printf '%q ' "$0" "$@")"
}

host_core_count() {
  echo "${OMATERM_TOTAL_CORES:-$(nproc 2>/dev/null || echo 0)}"
}

host_total_ram_mb() {
  if [[ -n ${OMATERM_TOTAL_RAM_MB:-} ]]; then
    echo "$OMATERM_TOTAL_RAM_MB"
    return
  fi

  awk '/^MemTotal:/ { printf "%d", $2 / 1024; ok = 1 } END { if (!ok) print 0 }' /proc/meminfo 2>/dev/null || echo 0
}

# CPU set reserving the first HOST_RESERVE_CORES cores for the host. Fails (and
# prints nothing) when there aren't enough cores to leave the host its reserve.
omaterm_cpuset() {
  local cores
  cores="$(host_core_count)"

  if ((cores - HOST_RESERVE_CORES < 1)); then
    return 1
  fi

  printf '%d-%d' "$HOST_RESERVE_CORES" "$((cores - 1))"
}

# Per-Omaterm memory in MB once the host reserve is divided across `count`
# Omaterms. Fails when the reserve leaves nothing to share.
omaterm_mem_mb() {
  local count="$1" avail
  avail="$(($(host_total_ram_mb) - HOST_RESERVE_RAM_MB))"

  if ((count < 1 || avail < 1)); then
    return 1
  fi

  printf '%d' "$((avail / count))"
}

# Fill the global LIMIT_ARGS array with docker resource flags for a layout of
# `count` Omaterms.
build_limit_args() {
  local count="$1" cpuset mem
  LIMIT_ARGS=()

  if [[ -n ${OMATERM_NO_LIMITS:-} ]]; then
    return
  fi

  if cpuset="$(omaterm_cpuset)"; then
    LIMIT_ARGS+=(--cpuset-cpus "$cpuset")
  fi

  LIMIT_ARGS+=(--cpu-shares "$CPU_SHARES")

  if mem="$(omaterm_mem_mb "$count")"; then
    LIMIT_ARGS+=(--memory "${mem}m" --memory-swap "${mem}m")
  fi
}

# Re-divide host resources across every existing Omaterm for a total of `count`.
rebalance_limits() {
  local count="$1" name mem names

  build_limit_args "$count"
  ((${#LIMIT_ARGS[@]})) || return 0

  mapfile -t names < <(omaterm_names)
  ((${#names[@]})) || return 0

  if mem="$(omaterm_mem_mb "$count")"; then
    echo "==> Dividing host resources across $count Omaterm(s): ${mem}m memory each" >&2
  fi

  for name in "${names[@]}"; do
    docker update "${LIMIT_ARGS[@]}" "$name" >/dev/null 2>&1 ||
      echo "Warning: could not apply resource limits to $name" >&2
  done
}

choose_omaterm() {
  local action="$1"
  shift

  if (($# == 0)); then
    return 1
  elif (($# == 1)); then
    printf '%s\n' "$1"
    return
  fi

  if command -v gum >/dev/null 2>&1 && [ -t 0 ]; then
    printf '%s\n' "$@" | gum choose --header "$action Omaterm"
    return
  fi

  if [ -t 0 ] && [ -r /dev/tty ]; then
    local index choice

    echo "$action Omaterm:" >/dev/tty
    index=1
    for choice in "$@"; do
      printf '  %d) %s\n' "$index" "$choice" >/dev/tty
      index=$((index + 1))
    done

    while true; do
      read -r -p "> " choice </dev/tty
      if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= $# )); then
        printf '%s\n' "${!choice}"
        return
      fi
    done
  fi

  echo "Multiple Omaterm containers found. Re-run from an interactive terminal." >&2
  return 1
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Error: --op requires '$command_name' on the host." >&2
    exit 1
  fi
}

op_item_field() {
  local item_json="$1" field="$2"

  printf '%s' "$item_json" |
    jq -r --arg field "$field" '
      (.fields // []) |
      (
        map(select((.section? == null) and (.label == $field or .id == $field))) +
        map(select(.label == $field or .id == $field))
      ) |
      .[0].value // empty
    '
}

op_item_json() {
  local op_ref="$1" path vault item extra

  if [[ $op_ref == op://* ]]; then
    path="${op_ref#op://}"
    IFS=/ read -r vault item extra <<<"$path"

    if [[ -z $vault || -z $item || -n $extra ]]; then
      echo "Error: --op expects an item reference like op://VAULT/ITEM, not a field reference." >&2
      return 1
    fi

    op item get "$item" --vault "$vault" --format json
  else
    op item get "$op_ref" --format json
  fi
}

load_setup_from_op() {
  local op_ref="$1" item_json value loaded=0

  require_command op
  require_command jq

  item_json="$(op_item_json "$op_ref")" || {
    echo "Error: could not read 1Password item: $op_ref" >&2
    exit 1
  }

  value="$(op_item_field "$item_json" "git-name")"
  if [[ -n $value && -z $git_name ]]; then git_name="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "git-email")"
  if [[ -n $value && -z $git_email ]]; then git_email="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "gh-token")"
  if [[ -n $value && -z $gh_token ]]; then gh_token="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "ts-token")"
  if [[ -n $value && -z $ts_token ]]; then ts_token="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "ts-host")"
  if [[ -n $value && -z $tailscale_host ]]; then tailscale_host="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "op-token")"
  if [[ -n $value && -z $op_token ]]; then op_token="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "ssh-key")"
  if [[ -n $value && -z $ssh_key ]]; then ssh_key="$value"; loaded=1; fi

  if (( ! loaded )); then
    echo "Error: 1Password item has no recognized Omaterm setup fields." >&2
    echo "Expected top-level fields: git-name, git-email, gh-token, ts-token, ts-host, op-token, ssh-key." >&2
    exit 1
  fi
}

wait_for_prepare() {
  local name="$1" status

  while true; do
    # The marker holds the prepare command's exit status once it finishes.
    if status="$(docker exec "$name" cat "$PREPARE_DONE_MARKER" 2>/dev/null)"; then
      if [[ $status == 0 ]]; then
        return 0
      fi

      echo "Omaterm prepare failed for $name with exit status $status." >&2
      return "$status"
    fi

    # No marker yet: if the container has already died, prepare never finished.
    if ! container_running "$name"; then
      echo "Omaterm prepare failed for $name." >&2
      return 1
    fi

    sleep 1
  done
}

run_new() {
  local name="" clone_source="" tailscale_host="" mount_docker=0 prepare=0 status
  local setup_op="" overrides=0 image reset_cmd
  local git_name="" git_email="" gh_token="" ts_token="" op_token="" ssh_key=""
  local prepare_command=""
  local docker_args=() env_args=() name_args=() command_args=() existing

  while (($#)); do
    case "$1" in
      -c | --clone)         clone_source="${2:-}"; shift 2 ;;
      --op)                 setup_op="${2:-}"; overrides=1; shift 2 ;;
      -p | --prepare)       prepare=1; prepare_command="${2:-}"; shift 2 ;;
      --ts-host)            tailscale_host="${2:-}"; overrides=1; shift 2 ;;
      --git-name)           git_name="${2:-}"; overrides=1; shift 2 ;;
      --git-email)          git_email="${2:-}"; overrides=1; shift 2 ;;
      --gh-token)           gh_token="${2:-}"; overrides=1; shift 2 ;;
      --ts-token)           ts_token="${2:-}"; overrides=1; shift 2 ;;
      --op-token)           op_token="${2:-}"; overrides=1; shift 2 ;;
      --ssh-key)            ssh_key="${2:-}"; overrides=1; shift 2 ;;
      -d | --docker-access) mount_docker=1; shift ;;
      -*)                   usage; exit 2 ;;
      *)                    name="$1"; shift ;;
    esac
  done

  if [[ -n $setup_op ]]; then
    load_setup_from_op "$setup_op"
  fi

  if [[ -z $name ]]; then
    usage
    exit 2
  fi

  if [[ -n $clone_source && $prepare == 1 ]]; then
    echo "Error: --prepare cannot be combined with --clone." >&2
    exit 2
  fi

  validate_name "$name"

  if container_exists "$name"; then
    echo "Omaterm already exists: $name" >&2
    exit 1
  fi

  if [[ -n $clone_source ]]; then
    validate_name "$clone_source"
    container_exists "$clone_source" || {
      echo "No such Omaterm: $clone_source" >&2
      exit 1
    }

    # Snapshot the source's filesystem into a fresh image to launch the clone from.
    image="$CLONE_IMAGE_REPO:$name"
    echo "==> Cloning $clone_source into $name..." >&2
    docker commit "$clone_source" "$image" >/dev/null
  else
    image="$IMAGE"
  fi

  name_args=(--name "$name")

  # Adding this Omaterm shrinks every existing Omaterm's memory share; re-divide
  # them before launching, then claim the same share for the new one.
  mapfile -t existing < <(omaterm_names)
  rebalance_limits "$((${#existing[@]} + 1))"
  build_limit_args "$((${#existing[@]} + 1))"

  if [ -t 0 ] && [ -r /dev/tty ]; then
    exec </dev/tty
  fi

  if (( mount_docker )); then
    docker_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
  fi

  if [[ -n $clone_source ]]; then
    # docker commit bakes the source's setup env (tokens) and Tailscale node
    # identity into the image. Pass every setup var explicitly — empty unless
    # overridden — so the inherited env can't silently re-apply, and always wipe
    # the Tailscale state so the clone never shares the source's node.
    env_args=(
      -e "OMATERM_SETUP_TS_HOST=$tailscale_host"
      -e "OMATERM_SETUP_GIT_NAME=$git_name"
      -e "OMATERM_SETUP_GIT_EMAIL=$git_email"
      -e "OMATERM_SETUP_GH_TOKEN=$gh_token"
      -e "OMATERM_SETUP_TS_AUTH_KEY=$ts_token"
      -e "OMATERM_SETUP_OP_TOKEN=$op_token"
      -e "OMATERM_SETUP_SSH_KEY=$ssh_key"
    )

    # Reset the Tailscale identity, and clear the setup marker when overrides
    # were given so omaterm-setup re-runs and applies them on first boot.
    reset_cmd="rm -f $TAILSCALE_STATE_FILE $TAILSCALE_HOSTNAME_FILE"
    (( overrides )) && reset_cmd+=" $SETUP_DONE_MARKER"

    exec docker run -it "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      --entrypoint bash \
      "$image" \
      -c "$reset_cmd; exec /home/omaterm/.local/bin/omaterm-entrypoint"
  fi

  [[ -n $tailscale_host ]] && env_args+=(-e "OMATERM_SETUP_TS_HOST=$tailscale_host")
  [[ -n $git_name ]] && env_args+=(-e "OMATERM_SETUP_GIT_NAME=$git_name")
  [[ -n $git_email ]] && env_args+=(-e "OMATERM_SETUP_GIT_EMAIL=$git_email")
  [[ -n $gh_token ]] && env_args+=(-e "OMATERM_SETUP_GH_TOKEN=$gh_token")
  [[ -n $ts_token ]] && env_args+=(-e "OMATERM_SETUP_TS_AUTH_KEY=$ts_token")
  [[ -n $op_token ]] && env_args+=(-e "OMATERM_SETUP_OP_TOKEN=$op_token")
  [[ -n $ssh_key ]] && env_args+=(-e "OMATERM_SETUP_SSH_KEY=$ssh_key")

  if (( prepare )); then
    # Run the prepare command once, recording its exit status to the marker
    # whether it succeeds or fails. The container then drops to an interactive
    # login shell either way, so a failed prepare stays attachable for
    # inspection while wait_for_prepare can still tell it apart from success.
    command_args=(-c "if [ ! -f $PREPARE_DONE_MARKER ]; then mkdir -p $(dirname "$PREPARE_DONE_MARKER"); if $prepare_command; then s=0; else s=\$?; fi; echo \$s >$PREPARE_DONE_MARKER.tmp && mv $PREPARE_DONE_MARKER.tmp $PREPARE_DONE_MARKER; fi; exec bash -l")

    set +e
    docker run -dit "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      "$IMAGE" \
      "${command_args[@]}" >/dev/null
    status=$?
    set -e

    (( status == 0 )) || exit "$status"

    echo "==> Preparing $name..." >&2
    wait_for_prepare "$name"
    exit "$?"
  else
    exec docker run -it "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      "$IMAGE" \
      "${command_args[@]}"
  fi
}

connect_omaterm() {
  local name="$1"

  if container_running "$name"; then
    exec docker attach "$name"
  else
    exec docker start -ai "$name"
  fi
}

run_connect() {
  local name="${1:-}" names

  if [[ -n $name ]]; then
    validate_name "$name"
    container_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }

    mapfile -t names < <(omaterm_names)
    rebalance_limits "${#names[@]}"
    connect_omaterm "$name"
  fi

  mapfile -t names < <(omaterm_names)

  if ((${#names[@]} == 0)); then
    run_new "$DEFAULT_NAME" -d
  fi

  name="$(choose_omaterm "Start" "${names[@]}")"

  rebalance_limits "${#names[@]}"

  connect_omaterm "$name"
}

# Prepare state for a hand: "ready"/"failed (N)"/"preparing" for prepared hands,
# "-" for plain interactive ones. The marker holds the prepare exit status and
# can only be read while the container is running.
prepare_status() {
  local name="$1" state="$2" code

  if ! docker inspect -f '{{json .Config.Cmd}}' "$name" 2>/dev/null | grep -q "$PREPARE_DONE_MARKER"; then
    echo "-"
  elif [[ $state != running ]]; then
    echo "stopped"
  elif code="$(docker exec "$name" cat "$PREPARE_DONE_MARKER" 2>/dev/null)"; then
    [[ $code == 0 ]] && echo "ready" || echo "failed ($code)"
  else
    echo "preparing"
  fi
}

run_ls() {
  local names name state mem_bytes mem
  mapfile -t names < <(omaterm_names)
  ((${#names[@]})) || return 0

  {
    printf 'NAME\tSTATUS\tMEMORY\tPREPARE\n'
    for name in "${names[@]}"; do
      state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo '?')"

      mem_bytes="$(docker inspect -f '{{.HostConfig.Memory}}' "$name" 2>/dev/null || echo 0)"
      if [[ $mem_bytes =~ ^[0-9]+$ ]] && ((mem_bytes > 0)); then
        mem="$((mem_bytes / 1024 / 1024))m"
      else
        mem="unlimited"
      fi

      printf '%s\t%s\t%s\t%s\n' "$name" "$state" "$mem" "$(prepare_status "$name" "$state")"
    done
  } | column -t -s "$(printf '\t')"
}

run_exec() {
  local name="$1" command workdir="" docker_args=()
  shift

  validate_name "$name"
  container_exists "$name" || {
    echo "No such Omaterm: $name" >&2
    exit 1
  }

  if [[ ${1:-} == "--" ]]; then
    shift
  fi

  while (($#)); do
    case "$1" in
      -w | --workdir)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        workdir="${2:-}"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  (($#)) || {
    usage
    exit 2
  }

  command="$*"
  [[ -n $workdir ]] && docker_args+=(-w "$workdir")

  if ! container_running "$name"; then
    docker start "$name" >/dev/null
  fi

  exec docker exec "${docker_args[@]}" "$name" bash -lc "$command"
}

# Drop the snapshot image a clone was launched from, if it had one.
remove_clone_image() {
  docker image rm "$CLONE_IMAGE_REPO:$1" >/dev/null 2>&1 || true
}

run_rm() {
  local names name="${1:-}"

  if [[ $name == "-a" ]]; then
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    docker rm -f "${names[@]}"
    for name in "${names[@]}"; do
      remove_clone_image "$name"
    done
    return
  elif [[ -n $name ]]; then
    validate_name "$name"
    container_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }
  else
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    name="$(choose_omaterm "Remove" "${names[@]}")"
  fi

  docker rm -f "$name"
  remove_clone_image "$name"

  # One fewer Omaterm means a larger memory share for the survivors.
  mapfile -t names < <(omaterm_names)
  rebalance_limits "${#names[@]}"
}

ensure_docker_group "$@"

case "${1:-}" in
  "")      run_connect ;;
  new)     run_new "${@:2}" ;;
  connect) run_connect "${2:-}" ;;
  ls)      run_ls ;;
  exec)    run_exec "${@:2}" ;;
  rm)      run_rm "${2:-}" ;;
  -h)      usage ;;
  *)
    usage
    exit 2
    ;;
esac
