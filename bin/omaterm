#!/usr/bin/env bash
set -euo pipefail

IMAGE="${OMATERM_IMAGE:-ghcr.io/omacom-io/omaterm}"
DEFAULT_NAME="omaterm"
LABEL="omaterm=1"
PREPARE_DONE_MARKER="/home/omaterm/.local/state/omaterm/prepare-done"

# Resource limits. The host keeps a reserved slice for itself; the rest is
# divided across all Omaterms. CPU is shared dynamically with cpu-shares over
# the cores not reserved for the host (full box when one runs alone, fair split
# under contention). Memory is hard-partitioned evenly by Omaterm count, since
# memory can't degrade gracefully the way CPU does. Set OMATERM_NO_LIMITS=1 to
# opt out entirely.
HOST_RESERVE_CORES="${OMATERM_HOST_RESERVE_CORES:-1}"
HOST_RESERVE_RAM_MB="${OMATERM_HOST_RESERVE_RAM_MB:-2048}"
CPU_SHARES="${OMATERM_CPU_SHARES:-1024}"

usage() {
  cat >&2 <<'EOF'
Usage:
  omaterm
  omaterm new NAME [-d|--docker-access] [-p|--prepare COMMAND]
    [--op ITEM]
    [--git-name NAME] [--git-email EMAIL] [--gh-token TOKEN]
    [--ts-token TOKEN] [--ts-host HOSTNAME] [--op-token TOKEN]
    [--ssh-key PUBLIC_KEY]
  omaterm connect [NAME]
  omaterm ls
  omaterm exec NAME [-w|--workdir DIR] COMMAND...
  omaterm rm [-a|NAME]
EOF
}

validate_name() {
  local name="$1"

  if [[ ! $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
    echo "Invalid Omaterm name: $name" >&2
    echo "Use letters, numbers, dots, underscores, and hyphens." >&2
    exit 2
  fi
}

omaterm_names() {
  docker container ls -a --filter "label=$LABEL" --format '{{.Names}}' | sort -u
}

container_exists() {
  docker container inspect "$1" >/dev/null 2>&1
}

container_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$1")" == "true" ]]
}

host_core_count() {
  echo "${OMATERM_TOTAL_CORES:-$(nproc 2>/dev/null || echo 0)}"
}

host_total_ram_mb() {
  if [[ -n ${OMATERM_TOTAL_RAM_MB:-} ]]; then
    echo "$OMATERM_TOTAL_RAM_MB"
    return
  fi

  awk '/^MemTotal:/ { printf "%d", $2 / 1024; ok = 1 } END { if (!ok) print 0 }' /proc/meminfo 2>/dev/null || echo 0
}

# CPU set reserving the first HOST_RESERVE_CORES cores for the host. Fails (and
# prints nothing) when there aren't enough cores to leave the host its reserve.
omaterm_cpuset() {
  local cores
  cores="$(host_core_count)"

  if ((cores - HOST_RESERVE_CORES < 1)); then
    return 1
  fi

  printf '%d-%d' "$HOST_RESERVE_CORES" "$((cores - 1))"
}

# Per-Omaterm memory in MB once the host reserve is divided across `count`
# Omaterms. Fails when the reserve leaves nothing to share.
omaterm_mem_mb() {
  local count="$1" avail
  avail="$(($(host_total_ram_mb) - HOST_RESERVE_RAM_MB))"

  if ((count < 1 || avail < 1)); then
    return 1
  fi

  printf '%d' "$((avail / count))"
}

# Fill the global LIMIT_ARGS array with docker resource flags for a layout of
# `count` Omaterms.
build_limit_args() {
  local count="$1" cpuset mem
  LIMIT_ARGS=()

  if [[ -n ${OMATERM_NO_LIMITS:-} ]]; then
    return
  fi

  if cpuset="$(omaterm_cpuset)"; then
    LIMIT_ARGS+=(--cpuset-cpus "$cpuset")
  fi

  LIMIT_ARGS+=(--cpu-shares "$CPU_SHARES")

  if mem="$(omaterm_mem_mb "$count")"; then
    LIMIT_ARGS+=(--memory "${mem}m" --memory-swap "${mem}m")
  fi
}

# Re-divide host resources across every existing Omaterm for a total of `count`.
rebalance_limits() {
  local count="$1" name mem names

  build_limit_args "$count"
  ((${#LIMIT_ARGS[@]})) || return 0

  mapfile -t names < <(omaterm_names)
  ((${#names[@]})) || return 0

  if mem="$(omaterm_mem_mb "$count")"; then
    echo "==> Dividing host resources across $count Omaterm(s): ${mem}m memory each" >&2
  fi

  for name in "${names[@]}"; do
    docker update "${LIMIT_ARGS[@]}" "$name" >/dev/null 2>&1 ||
      echo "Warning: could not apply resource limits to $name" >&2
  done
}

choose_omaterm() {
  local action="$1"
  shift

  if (($# == 0)); then
    return 1
  elif (($# == 1)); then
    printf '%s\n' "$1"
    return
  fi

  if command -v gum >/dev/null 2>&1 && [ -t 0 ]; then
    printf '%s\n' "$@" | gum choose --header "$action Omaterm"
    return
  fi

  if [ -t 0 ] && [ -r /dev/tty ]; then
    local index choice

    echo "$action Omaterm:" >/dev/tty
    index=1
    for choice in "$@"; do
      printf '  %d) %s\n' "$index" "$choice" >/dev/tty
      index=$((index + 1))
    done

    while true; do
      read -r -p "> " choice </dev/tty
      if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= $# )); then
        printf '%s\n' "${!choice}"
        return
      fi
    done
  fi

  echo "Multiple Omaterm containers found. Re-run from an interactive terminal." >&2
  return 1
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Error: --op requires '$command_name' on the host." >&2
    exit 1
  fi
}

op_item_field() {
  local item_json="$1" field="$2"

  printf '%s' "$item_json" |
    jq -r --arg field "$field" '
      (.fields // []) |
      (
        map(select((.section? == null) and (.label == $field or .id == $field))) +
        map(select(.label == $field or .id == $field))
      ) |
      .[0].value // empty
    '
}

op_item_json() {
  local op_ref="$1" path vault item extra

  if [[ $op_ref == op://* ]]; then
    path="${op_ref#op://}"
    IFS=/ read -r vault item extra <<<"$path"

    if [[ -z $vault || -z $item || -n $extra ]]; then
      echo "Error: --op expects an item reference like op://VAULT/ITEM, not a field reference." >&2
      return 1
    fi

    op item get "$item" --vault "$vault" --format json
  else
    op item get "$op_ref" --format json
  fi
}

load_setup_from_op() {
  local op_ref="$1" item_json value loaded=0

  require_command op
  require_command jq

  item_json="$(op_item_json "$op_ref")" || {
    echo "Error: could not read 1Password item: $op_ref" >&2
    exit 1
  }

  value="$(op_item_field "$item_json" "git-name")"
  if [[ -n $value && -z $git_name ]]; then git_name="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "git-email")"
  if [[ -n $value && -z $git_email ]]; then git_email="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "gh-token")"
  if [[ -n $value && -z $gh_token ]]; then gh_token="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "ts-token")"
  if [[ -n $value && -z $ts_token ]]; then ts_token="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "ts-host")"
  if [[ -n $value && -z $tailscale_host ]]; then tailscale_host="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "op-token")"
  if [[ -n $value && -z $op_token ]]; then op_token="$value"; loaded=1; fi
  value="$(op_item_field "$item_json" "ssh-key")"
  if [[ -n $value && -z $ssh_key ]]; then ssh_key="$value"; loaded=1; fi

  if (( ! loaded )); then
    echo "Error: 1Password item has no recognized Omaterm setup fields." >&2
    echo "Expected top-level fields: git-name, git-email, gh-token, ts-token, ts-host, op-token, ssh-key." >&2
    exit 1
  fi
}

wait_for_prepare() {
  local name="$1" exit_code

  while true; do
    if docker exec "$name" test -f "$PREPARE_DONE_MARKER" >/dev/null 2>&1; then
      return 0
    fi

    if ! container_running "$name"; then
      exit_code="$(docker inspect -f '{{.State.ExitCode}}' "$name" 2>/dev/null || true)"

      if [[ -n $exit_code && $exit_code != "0" ]]; then
        echo "Omaterm prepare failed for $name with exit status $exit_code." >&2
        return "$exit_code"
      fi

      echo "Omaterm prepare failed for $name." >&2
      return 1
    fi

    sleep 1
  done
}

stream_prepare_until_ready() {
  local name="$1" logs_pid status

  docker logs -f "$name" &
  logs_pid=$!
  sleep 0.1

  set +e
  wait_for_prepare "$name"
  status=$?
  kill "$logs_pid" >/dev/null 2>&1
  wait "$logs_pid" 2>/dev/null
  set -e

  return "$status"
}

run_new() {
  local name="" tailscale_host="" mount_docker=0 prepare=0 status
  local setup_op=""
  local git_name="" git_email="" gh_token="" ts_token="" op_token="" ssh_key=""
  local prepare_command=""
  local docker_args=() env_args=() name_args=() command_args=() existing ready_command

  while (($#)); do
    case "$1" in
      --op)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        setup_op="${2:-}"
        shift 2
        ;;
      -p | --prepare)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        prepare=1
        prepare_command="${2:-}"
        shift 2
        ;;
      --ts-host)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        tailscale_host="${2:-}"
        shift 2
        ;;
      --git-name)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        git_name="${2:-}"
        shift 2
        ;;
      --git-email)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        git_email="${2:-}"
        shift 2
        ;;
      --gh-token)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        gh_token="${2:-}"
        shift 2
        ;;
      --ts-token)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        ts_token="${2:-}"
        shift 2
        ;;
      --op-token)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        op_token="${2:-}"
        shift 2
        ;;
      --ssh-key)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        ssh_key="${2:-}"
        shift 2
        ;;
      -d | --docker-access)
        mount_docker=1
        shift
        ;;
      *)
        if [[ $1 == -* ]]; then
          usage
          exit 2
        elif [[ -z $name ]]; then
          name="$1"
          shift
        else
          usage
          exit 2
        fi
        ;;
    esac
  done

  if [[ -n $setup_op ]]; then
    load_setup_from_op "$setup_op"
  fi

  if [[ -z $name ]]; then
    usage
    exit 2
  fi

  validate_name "$name"

  if container_exists "$name"; then
    echo "Omaterm already exists: $name" >&2
    exit 1
  fi

  name_args=(--name "$name")

  # Adding this Omaterm shrinks every existing Omaterm's memory share; re-divide
  # them before launching, then claim the same share for the new one.
  mapfile -t existing < <(omaterm_names)
  rebalance_limits "$((${#existing[@]} + 1))"
  build_limit_args "$((${#existing[@]} + 1))"

  if [ -t 0 ] && [ -r /dev/tty ]; then
    exec </dev/tty
  fi

  [[ -n $tailscale_host ]] && env_args+=(-e "OMATERM_SETUP_TS_HOST=$tailscale_host")
  [[ -n $git_name ]] && env_args+=(-e "OMATERM_SETUP_GIT_NAME=$git_name")
  [[ -n $git_email ]] && env_args+=(-e "OMATERM_SETUP_GIT_EMAIL=$git_email")
  [[ -n $gh_token ]] && env_args+=(-e "OMATERM_SETUP_GH_TOKEN=$gh_token")
  [[ -n $ts_token ]] && env_args+=(-e "OMATERM_SETUP_TS_AUTH_KEY=$ts_token")
  [[ -n $op_token ]] && env_args+=(-e "OMATERM_SETUP_OP_TOKEN=$op_token")
  [[ -n $ssh_key ]] && env_args+=(-e "OMATERM_SETUP_SSH_KEY=$ssh_key")

  if (( mount_docker )); then
    docker_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
  fi

  if (( prepare )); then
    ready_command="mkdir -p $(dirname "$PREPARE_DONE_MARKER") && touch $PREPARE_DONE_MARKER"
    command_args=(-c "if [ ! -f $PREPARE_DONE_MARKER ]; then $prepare_command && $ready_command; fi; exec bash -l")
  fi

  if (( prepare )); then
    set +e
    docker run -dit "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      "$IMAGE" \
      "${command_args[@]}" >/dev/null
    status=$?
    set -e

    (( status == 0 )) || exit "$status"

    stream_prepare_until_ready "$name"
    exit "$?"
  else
    exec docker run -it "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      "$IMAGE" \
      "${command_args[@]}"
  fi
}

connect_omaterm() {
  local name="$1"

  if container_running "$name"; then
    exec docker attach "$name"
  else
    exec docker start -ai "$name"
  fi
}

run_connect() {
  local name="${1:-}" names

  if [[ -n $name ]]; then
    validate_name "$name"
    container_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }

    mapfile -t names < <(omaterm_names)
    rebalance_limits "${#names[@]}"
    connect_omaterm "$name"
  fi

  mapfile -t names < <(omaterm_names)

  if ((${#names[@]} == 0)); then
    run_new "$DEFAULT_NAME" -d
  fi

  name="$(choose_omaterm "Start" "${names[@]}")"

  rebalance_limits "${#names[@]}"

  connect_omaterm "$name"
}

run_ls() {
  local names name state mem_bytes mem
  mapfile -t names < <(omaterm_names)
  ((${#names[@]})) || return 0

  {
    printf 'NAME\tSTATUS\tMEMORY\tPREPARE\n'
    for name in "${names[@]}"; do
      state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo '?')"

      mem_bytes="$(docker inspect -f '{{.HostConfig.Memory}}' "$name" 2>/dev/null || echo 0)"
      if [[ $mem_bytes =~ ^[0-9]+$ ]] && ((mem_bytes > 0)); then
        mem="$((mem_bytes / 1024 / 1024))m"
      else
        mem="unlimited"
      fi

      printf '%s\t%s\t%s\t%s\n' "$name" "$state" "$mem" "$(prepare_status "$name" "$state")"
    done
  } | column -t -s "$(printf '\t')"
}

run_exec() {
  local name="$1" command workdir="" docker_args=()
  shift

  validate_name "$name"
  container_exists "$name" || {
    echo "No such Omaterm: $name" >&2
    exit 1
  }

  if [[ ${1:-} == "--" ]]; then
    shift
  fi

  while (($#)); do
    case "$1" in
      -w | --workdir)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        workdir="${2:-}"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  (($#)) || {
    usage
    exit 2
  }

  command="$*"
  [[ -n $workdir ]] && docker_args+=(-w "$workdir")

  if ! container_running "$name"; then
    docker start "$name" >/dev/null
  fi

  exec docker exec "${docker_args[@]}" "$name" bash -lc "$command"
}

run_rm() {
  local names name="${1:-}"

  if [[ $name == "-a" ]]; then
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    docker rm -f "${names[@]}"
    return
  elif [[ -n $name ]]; then
    validate_name "$name"
    container_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }
  else
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    name="$(choose_omaterm "Remove" "${names[@]}")"
  fi

  docker rm -f "$name"

  # One fewer Omaterm means a larger memory share for the survivors.
  mapfile -t names < <(omaterm_names)
  rebalance_limits "${#names[@]}"
}

case "${1:-}" in
  "")      run_connect ;;
  new)     run_new "${@:2}" ;;
  connect) run_connect "${2:-}" ;;
  ls)      run_ls ;;
  exec)    run_exec "${@:2}" ;;
  rm)      run_rm "${2:-}" ;;
  -h)      usage ;;
  *)
    usage
    exit 2
    ;;
esac
