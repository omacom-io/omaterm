#!/usr/bin/env bash
set -euo pipefail

SETUP_HELPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/omaterm-setup-helper
source "$SETUP_HELPER_DIR/omaterm-setup-helper"

TAILSCALE_HOSTNAME_FILE="$HOME/.local/state/omaterm/tailscale-hostname"
TAILSCALE_STATE_FILE="${OMATERM_TAILSCALE_STATE_FILE:-/var/lib/tailscale/tailscaled.state}"
AUTH_KEY=""

usage() {
  echo "Usage: omaterm-setup-tailscale [--auth-key AUTH_KEY]" >&2
}

while (($#)); do
  case "$1" in
    --auth-key)
      AUTH_KEY="${2:-}"
      shift 2 || { usage; exit 2; }
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

set_hostname() {
  local -n target="$1"
  local current_name entered_hostname

  if [[ -n ${OMATERM_SETUP_TS_HOST:-} ]]; then
    if [[ $OMATERM_SETUP_TS_HOST =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]]; then
      mkdir -p "$(dirname "$TAILSCALE_HOSTNAME_FILE")" || return 1
      printf "%s\n" "$OMATERM_SETUP_TS_HOST" >"$TAILSCALE_HOSTNAME_FILE" || return 1
      target="$OMATERM_SETUP_TS_HOST"
      return
    fi

    echo "Invalid OMATERM_SETUP_TS_HOST. Use letters, numbers, and hyphens only, starting with a letter or number." >&2
    return 1
  fi

  current_name="$(cat "$TAILSCALE_HOSTNAME_FILE" 2>/dev/null || true)"
  current_name="${current_name:-$(hostname)}"

  while true; do
    echo >&2
    gum_input_into entered_hostname --prompt "Tailnet hostname: " --value "$current_name" || return 1
    entered_hostname="${entered_hostname:-$current_name}"

    if [[ $entered_hostname =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]]; then
      mkdir -p "$(dirname "$TAILSCALE_HOSTNAME_FILE")" || return 1
      printf "%s\n" "$entered_hostname" >"$TAILSCALE_HOSTNAME_FILE" || return 1
      target="$entered_hostname"
      return
    fi

    echo "Use letters, numbers, and hyphens only, starting with a letter or number." >&2
  done
}

has_saved_state() {
  sudo -n test -s "$TAILSCALE_STATE_FILE"
}

prompt_auth_key() {
  local -n auth_key_target="$1"
  local tailnet_hostname="$2"
  local entered_auth_key

  if [[ -n ${OMATERM_SETUP_TS_HOST:-} ]]; then
    echo "Cannot set Tailscale hostname to $tailnet_hostname without an existing Tailscale node or auth key." >&2
    return 1
  fi

  while [[ -z $auth_key_target ]]; do
    echo "Grab a new auth key from the 'generate install script' block on:"
    echo "https://login.tailscale.com/admin/machines/new-linux"
    echo

    gum_input_into entered_auth_key --password --placeholder "tskey-auth-kMyk..." --prompt "Tailscale auth key: " || return 1
    auth_key_target="$entered_auth_key"
  done

  # The while-condition's false exit (set once a key is entered) must not become
  # this function's return value, or the caller treats success as failure.
  return 0
}

setup_tailscale() {
  local tailnet_hostname="" tailscale_auth_key="$AUTH_KEY"

  set_hostname tailnet_hostname || return 1
  [[ -n $tailnet_hostname ]] || return 1

  if [[ -z $tailscale_auth_key ]] && tailscale status &>/dev/null; then
    echo "Renaming Tailscale node to $tailnet_hostname..."
    sudo -n tailscale set --hostname="$tailnet_hostname" || return 1
    echo "✓ Tailscale ($tailnet_hostname)"
    echo
    return 0
  fi

  if [[ -z $tailscale_auth_key ]] && has_saved_state; then
    echo "Bringing up Tailscale as $tailnet_hostname..."
    sudo -n tailscale up --ssh --accept-routes --hostname="$tailnet_hostname" || return 1
    echo "✓ Tailscale ($tailnet_hostname)"
    echo
    return 0
  fi

  [[ -n $tailscale_auth_key ]] || prompt_auth_key tailscale_auth_key "$tailnet_hostname" || return 1

  echo
  echo "Bringing up Tailscale..."
  sudo -n tailscale up --ssh --accept-routes --hostname="$tailnet_hostname" --auth-key="$tailscale_auth_key" || return 1

  echo "✓ Tailscale"
  echo
}

setup_tailscale
