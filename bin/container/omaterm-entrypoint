#!/usr/bin/env bash
set -euo pipefail

TAILSCALE_STATE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_SOCKET="/var/run/tailscale/tailscaled.sock"
HOST_DOCKER_SOCKET="/var/run/docker.sock"

tailscaled_running() {
  local comm

  for comm in /proc/[0-9]*/comm; do
    [ "$(cat "$comm" 2>/dev/null || true)" = "tailscaled" ] && return 0
  done

  return 1
}

start_tailscaled() {
  tailscaled_running && return 0

  mkdir -p "$(dirname "$TAILSCALE_SOCKET")" "$(dirname "$TAILSCALE_STATE")"
  rm -f "$TAILSCALE_SOCKET"

  tailscaled \
    --tun=userspace-networking \
    --state="$TAILSCALE_STATE" \
    --socket="$TAILSCALE_SOCKET" \
    >/var/log/tailscaled.log 2>&1 &
}

ensure_host_docker_access() {
  [ -S "$HOST_DOCKER_SOCKET" ] || return 0

  local socket_gid

  socket_gid="$(stat -c '%g' "$HOST_DOCKER_SOCKET")"

  # Aligning the docker group can fail — the socket may be owned by gid 0 or a
  # gid another group already holds. That must not kill PID 1: join the owning
  # group directly instead so the box still boots with sudoless docker access.
  if groupmod -g "$socket_gid" docker 2>/dev/null; then
    usermod -aG docker omaterm
  else
    usermod -aG "$socket_gid" omaterm || true
  fi
}

ensure_host_docker_access
start_tailscaled

OMATERM_ENV=(
  HOME=/home/omaterm
  USER=omaterm
  LOGNAME=omaterm
  SHELL=/bin/bash
  TERM="${TERM:-xterm-256color}"
  PATH="/home/omaterm/.local/share/mise/shims:/home/omaterm/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
)

SETUP_ENV=("${OMATERM_ENV[@]}")
for env_name in \
  OMATERM_SETUP_TS_HOST \
  OMATERM_SETUP_GIT_NAME \
  OMATERM_SETUP_GIT_EMAIL \
  OMATERM_SETUP_GH_TOKEN \
  OMATERM_SETUP_TS_AUTH_KEY \
  OMATERM_SETUP_OP_TOKEN \
  OMATERM_SETUP_SSH_KEY; do
  if [ -n "${!env_name:-}" ]; then
    SETUP_ENV+=("$env_name=${!env_name}")
  fi
done

runuser -u omaterm -- env "${SETUP_ENV[@]}" /home/omaterm/.local/bin/omaterm-setup

# A detached box (omaterm new --detach) has no terminal attached, so there is no
# interactive login shell to keep the container alive — one would read EOF and
# exit, taking the container with it. Idle as PID 1 instead and let the caller
# drive the box with `omaterm exec`.
if [ -n "${OMATERM_DETACH:-}" ]; then
  exec runuser -u omaterm -- env "${OMATERM_ENV[@]}" sleep infinity
fi

exec runuser -u omaterm -- env "${OMATERM_ENV[@]}" bash -l "$@"
