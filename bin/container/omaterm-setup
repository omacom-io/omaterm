setup_unattended() {
  [[ -n ${OMATERM_SETUP_GIT_NAME:-} ||
    -n ${OMATERM_SETUP_GIT_EMAIL:-} ||
    -n ${OMATERM_SETUP_GH_TOKEN:-} ||
    -n ${OMATERM_SETUP_TS_AUTH_KEY:-} ||
    -n ${OMATERM_SETUP_TS_HOST:-} ||
    -n ${OMATERM_SETUP_OP_TOKEN:-} ||
    -n ${OMATERM_SETUP_SSH_KEY:-} ]] || return 1

  SETUP_UNATTENDED=1

  if [[ -n ${OMATERM_SETUP_TS_HOST:-} ]]; then
    omaterm-setup-tailscale --auth-key "${OMATERM_SETUP_TS_AUTH_KEY:-}" || exit 1
  fi

  if [[ -n ${OMATERM_SETUP_GIT_NAME:-} && -n ${OMATERM_SETUP_GIT_EMAIL:-} ]]; then
    omaterm-setup-git --name "$OMATERM_SETUP_GIT_NAME" --email "$OMATERM_SETUP_GIT_EMAIL" || exit 1
  fi

  if [[ -n ${OMATERM_SETUP_GH_TOKEN:-} ]]; then
    omaterm-setup-github --token "$OMATERM_SETUP_GH_TOKEN" || exit 1
  fi

  if [[ -n ${OMATERM_SETUP_SSH_KEY:-} ]]; then
    omaterm-setup-ssh --key "$OMATERM_SETUP_SSH_KEY" || exit 1
  fi

  if [[ -n ${OMATERM_SETUP_OP_TOKEN:-} ]]; then
    omaterm-setup-1password --service-token "$OMATERM_SETUP_OP_TOKEN" || exit 1
  fi
}

gum_confirm() {
  local status interrupted=0

  set +e
  trap 'interrupted=1' INT
  gum confirm "$@"
  status=$?
  trap - INT
  set -e

  if (( interrupted || status == 130 || status > 1 )); then
    SETUP_FINISHED=1
    return 130
  fi

  return "$status"
}

run_setup_helper() {
  local helper="$1" status
  shift

  set +e
  "$helper" "$@"
  status=$?
  set -e

  if (( status == 130 || status > 1 )); then
    SETUP_FINISHED=1
    return 1
  elif (( status != 0 )); then
    return 1
  fi
}

setup_git_identity() {
  git config --global user.name &>/dev/null && git config --global user.email &>/dev/null && return
  gum_confirm "Identify for Git?" || return 0
  run_setup_helper omaterm-setup-git || return 1
}

setup_gh_authentication() {
  gh auth status &>/dev/null && return
  gum_confirm "Authenticate with GitHub?" || return 0
  run_setup_helper omaterm-setup-github || return 1
}

setup_tailscale() {
  tailscale status &>/dev/null && return
  gum_confirm "Connect to Tailscale?" || return 0
  run_setup_helper omaterm-setup-tailscale || return 1
}

setup_ssh_public_key() {
  gum_confirm "Add SSH public key for remote access?" || return 0
  run_setup_helper omaterm-setup-ssh || return 1
}

setup_1password() {
  gum_confirm "Authenticate with 1Password?" || return 0
  run_setup_helper omaterm-setup-1password || return 1
}

run_setup_section() {
  local label="$1"
  shift

  (( SETUP_FINISHED )) && return 0

  if "$@"; then
    return 0
  fi

  echo
  echo "Skipping $label after an error."
  echo
  return 0
}

setup_interactively() {
  run_setup_section "Git identity" setup_git_identity
  run_setup_section "GitHub authentication" setup_gh_authentication
  run_setup_section "Tailscale setup" setup_tailscale
  run_setup_section "SSH key setup" setup_ssh_public_key
  run_setup_section "1Password authentication" setup_1password
}

finish_setup() {
  mkdir -p "$(dirname "$SETUP_DONE_MARKER")"
  touch "$SETUP_DONE_MARKER"

  echo
  if (( SETUP_UNATTENDED )); then
    return
  elif [ -t 0 ] && [ -r /dev/tty ]; then
    gum spin --spinner "globe" --title "Setup complete. Press any key to tmux..." -- bash -c 'read -n 1 -s </dev/tty'
  else
    echo "Setup complete"
  fi
}

# Run setup
banner
setup_unattended || setup_interactively
finish_setup
