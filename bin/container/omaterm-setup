#!/usr/bin/env bash
set -euo pipefail

SETUP_DONE_MARKER="$HOME/.local/state/omaterm/setup-done"

SETUP_UNATTENDED=0
SETUP_FINISHED=0

if [[ -f $SETUP_DONE_MARKER ]]; then
  exit 0
fi

