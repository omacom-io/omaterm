#!/usr/bin/env bash
set -euo pipefail

MARKER="$HOME/.omaterm-setup-done"

if [ -f "$MARKER" ]; then
  exec bash -l "$@"
fi

is_docker() {
  [ "${OMATERM_DOCKER:-}" = "1" ] || [ -f /.dockerenv ]
}

setup_git_identity() {
  local git_name git_email

  if git config --global user.name &>/dev/null && git config --global user.email &>/dev/null; then
    return
  fi

  if ! gum confirm "Identify for Git?"; then
    return
  fi

  git_name="$(git config --global user.name 2>/dev/null || true)"
  git_email="$(git config --global user.email 2>/dev/null || true)"

  while [ -z "$git_name" ]; do
    git_name="$(gum input --prompt "Git Name: ")"
  done

  while [ -z "$git_email" ]; do
    git_email="$(gum input --prompt "Git Email: ")"
  done

  git config --global user.name "$git_name"
  git config --global user.email "$git_email"
  echo "✓ Git identity"
}

start_tailscaled() {
  if is_docker; then
    sudo mkdir -p /var/lib/tailscale /var/run/tailscale
    sudo rm -f /var/run/tailscale/tailscaled.sock
    sudo sh -c 'tailscaled --tun=userspace-networking --state=/var/lib/tailscale/tailscaled.state --socket=/var/run/tailscale/tailscaled.sock >/tmp/tailscaled.log 2>&1 &'
  else
    sudo sh -c 'tailscaled >/tmp/tailscaled.log 2>&1 &'
  fi

  sleep 2
}

setup_tailscale() {
  local tailscale_args

  command -v tailscale &>/dev/null || return 0
  tailscale status &>/dev/null && return

  echo
  if ! gum confirm "Connect to Tailscale?"; then
    return 0
  fi

  start_tailscaled

  tailscale_args=(--ssh --accept-routes)
  if [ -n "${OMATERM_HOSTNAME:-}" ]; then
    tailscale_args+=(--hostname="$OMATERM_HOSTNAME")
  fi

  sudo tailscale up "${tailscale_args[@]}"
}

setup_ssh_public_key() {
  local ssh_key

  echo
  if ! gum confirm "Add SSH public key for remote access?"; then
    return
  fi

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"

  ssh_key="$(gum input --placeholder "ssh-ed25519 AAAAC3..." --prompt "SSH key: ")"
  if [ -z "$ssh_key" ]; then
    return
  fi

  touch "$HOME/.ssh/authorized_keys"
  chmod 600 "$HOME/.ssh/authorized_keys"

  if grep -qxF "$ssh_key" "$HOME/.ssh/authorized_keys"; then
    echo "SSH key already present in authorized_keys."
  else
    echo "$ssh_key" >>"$HOME/.ssh/authorized_keys"
    echo "SSH key added to authorized_keys."
  fi

  if grep -q "^PasswordAuthentication no" /etc/ssh/sshd_config 2>/dev/null; then
    return
  fi

  if ! gum confirm "Disable password authentication for SSH (key-based auth only)?"; then
    return
  fi

  sudo sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
  sudo sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config

  if systemctl cat sshd.service &>/dev/null; then
    sudo systemctl restart sshd.service
  elif systemctl cat ssh.service &>/dev/null; then
    sudo systemctl restart ssh.service
  fi

  echo "SSH configured for key-based authentication only."
}

clear
echo
echo " ▄██████▄    ▄▄▄▄███▄▄▄▄      ▄████████     ███        ▄████████    ▄████████   ▄▄▄▄███▄▄▄▄
███    ███ ▄██▀▀▀███▀▀▀██▄   ███    ███ ▀█████████▄   ███    ███   ███    ███ ▄██▀▀▀███▀▀▀██▄
███    ███ ███   ███   ███   ███    ███    ▀███▀▀██   ███    █▀    ███    ███ ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███   ▀  ▄███▄▄▄      ▄███▄▄▄▄██▀ ███   ███   ███
███    ███ ███   ███   ███ ▀███████████     ███     ▀▀███▀▀▀     ▀▀███▀▀▀▀▀   ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███       ███    █▄  ▀███████████ ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███       ███    ███   ███    ███ ███   ███   ███
 ▀██████▀   ▀█   ███   █▀    ███    █▀     ▄████▀     ██████████   ███    ███  ▀█   ███   █▀
                                                                   ███    ███                "
echo
echo "Welcome to Omaterm! Let's get you set up."
echo

# Git identity
setup_git_identity

# GitHub CLI
if ! gh auth status &>/dev/null; then
  echo
  if gum confirm "Authenticate with GitHub?"; then
    gh auth login
  fi
fi

# SSH public key
setup_ssh_public_key

# Tailscale
setup_tailscale

echo
echo "✓ Setup complete!"
touch "$MARKER"
exec bash -l "$@"
