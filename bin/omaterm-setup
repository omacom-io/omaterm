#!/usr/bin/env bash
set -euo pipefail

MARKER="$HOME/.omaterm-setup-done"

if [ -f "$MARKER" ]; then
  exec bash -l "$@"
fi

is_docker() {
  [ "${OMATERM_DOCKER:-}" = "1" ] || [ -f /.dockerenv ]
}

setup_sudo_password() {
  local username
  username="${USER:-$(id -un)}"

  if ! is_docker || ! sudo -n grep -q NOPASSWD /etc/sudoers.d/omaterm 2>/dev/null; then
    return
  fi

  echo "Set a sudo password for $username."
  until sudo passwd "$username"; do
    echo "Password setup failed. Try again."
  done

  printf "%s ALL=(ALL) ALL\n" "$username" | sudo sh -c 'cat > /etc/sudoers.d/omaterm && chmod 0440 /etc/sudoers.d/omaterm'
  sudo -k

  echo
}

setup_git_identity() {
  local git_name git_email

  if git config --global user.name &>/dev/null && git config --global user.email &>/dev/null; then
    return
  fi

  if ! gum confirm "Identify for Git?"; then
    return
  fi

  git_name="$(git config --global user.name 2>/dev/null || true)"
  git_email="$(git config --global user.email 2>/dev/null || true)"

  while [ -z "$git_name" ]; do
    git_name="$(gum input --prompt "Git Name: ")"
  done

  while [ -z "$git_email" ]; do
    git_email="$(gum input --prompt "Git Email: ")"
  done

  git config --global user.name "$git_name"
  git config --global user.email "$git_email"
  echo "✓ Git identity"
}

echo
echo " ▄██████▄    ▄▄▄▄███▄▄▄▄      ▄████████     ███        ▄████████    ▄████████   ▄▄▄▄███▄▄▄▄
███    ███ ▄██▀▀▀███▀▀▀██▄   ███    ███ ▀█████████▄   ███    ███   ███    ███ ▄██▀▀▀███▀▀▀██▄
███    ███ ███   ███   ███   ███    ███    ▀███▀▀██   ███    █▀    ███    ███ ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███   ▀  ▄███▄▄▄      ▄███▄▄▄▄██▀ ███   ███   ███
███    ███ ███   ███   ███ ▀███████████     ███     ▀▀███▀▀▀     ▀▀███▀▀▀▀▀   ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███       ███    █▄  ▀███████████ ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███       ███    ███   ███    ███ ███   ███   ███
 ▀██████▀   ▀█   ███   █▀    ███    █▀     ▄████▀     ██████████   ███    ███  ▀█   ███   █▀
                                                                   ███    ███                "
echo
echo "Welcome to Omaterm! Let's get you set up."
echo

setup_sudo_password

# Git identity
setup_git_identity

# GitHub CLI
if ! gh auth status &>/dev/null; then
  echo
  if gum confirm "Authenticate with GitHub?"; then
    gh auth login
  fi
fi

# Tailscale
if command -v tailscale &>/dev/null && ! tailscale status &>/dev/null; then
  echo
  if gum confirm "Connect to Tailscale?"; then
    sudo tailscaled &>/dev/null &
    sudo tailscale up --ssh --accept-routes
  fi
fi

echo
echo "✓ Setup complete!"
touch "$MARKER"
exec bash -l "$@"
