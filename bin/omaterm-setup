#!/usr/bin/env bash
set -euo pipefail

SETUP_DONE_MARKER="$HOME/.local/state/omaterm/setup-done"

SETUP_JSON=""
SETUP_GIT_NAME=""
SETUP_GIT_EMAIL=""
SETUP_GH_TOKEN=""
SETUP_TAILSCALE_AUTH_KEY=""
SETUP_SSH_KEY=""
SETUP_1PASSWORD_TOKEN=""
SETUP_1PASSWORD_ADDRESS=""
SETUP_1PASSWORD_EMAIL=""
SETUP_1PASSWORD_SECRET_KEY=""
SETUP_1PASSWORD_SHORTHAND=""

SETUP_UNATTENDED=0
SETUP_SECTION_FAILED=0
SETUP_FINISHED=0
SETUP_IN_PROGRESS=0

if [[ -f $SETUP_DONE_MARKER ]]; then
  exit 0
fi

banner() {
  clear
  echo
  echo " ▄██████▄    ▄▄▄▄███▄▄▄▄      ▄████████     ███        ▄████████    ▄████████   ▄▄▄▄███▄▄▄▄
███    ███ ▄██▀▀▀███▀▀▀██▄   ███    ███ ▀█████████▄   ███    ███   ███    ███ ▄██▀▀▀███▀▀▀██▄
███    ███ ███   ███   ███   ███    ███    ▀███▀▀██   ███    █▀    ███    ███ ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███   ▀  ▄███▄▄▄      ▄███▄▄▄▄██▀ ███   ███   ███
███    ███ ███   ███   ███ ▀███████████     ███     ▀▀███▀▀▀     ▀▀███▀▀▀▀▀   ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███       ███    █▄  ▀███████████ ███   ███   ███
███    ███ ███   ███   ███   ███    ███     ███       ███    ███   ███    ███ ███   ███   ███
 ▀██████▀   ▀█   ███   █▀    ███    █▀     ▄████▀     ██████████   ███    ███  ▀█   ███   █▀
                                                                   ███    ███                "
  echo
}

json_value() {
  printf '%s' "$SETUP_JSON" | jq -r "$1"
}

decode_setup_token() {
  local encoded="$1"

  encoded="${encoded#OMATERM_SETUP_TOKEN=}"
  encoded="${encoded#export OMATERM_SETUP_TOKEN=}"
  encoded="${encoded#\"}"
  encoded="${encoded%\"}"
  encoded="${encoded#\'}"
  encoded="${encoded%\'}"
  encoded="$(printf '%s' "$encoded" | tr -d '[:space:]')"

  [[ -n $encoded ]] || return 1

  if ! SETUP_JSON="$(printf '%s' "$encoded" | base64 -d 2>/dev/null)"; then
    echo "Invalid setup token: could not decode base64."
    return 1
  fi

  if ! printf '%s' "$SETUP_JSON" | jq -e type >/dev/null; then
    echo "Invalid setup token: decoded value is not JSON."
    return 1
  fi
}

apply_setup_token() {
  local ts_auth_key="$(json_value '.tailscale.auth_key // .tailscale.token // empty')"
  local git_name="$(json_value '.git.name // empty')"
  local git_email="$(json_value '.git.email // empty')"
  local gh_token="$(json_value '.github.token // empty')"
  local ssh_key="$(json_value '.ssh.public_key // .ssh.key // empty')"
  local op_token="$(json_value '.onepassword.token // .onepassword.session // empty')"
  local op_address="$(json_value '.onepassword.account.address // empty')"
  local op_email="$(json_value '.onepassword.account.email // empty')"
  local op_secret_key="$(json_value '.onepassword.account.secret_key // empty')"
  local op_shorthand="$(json_value '.onepassword.account.shorthand // empty')"

  if [[ -n $ts_auth_key ]] && command -v tailscale &>/dev/null; then
    run_setup_helper omaterm-setup-tailscale --auth-key "$ts_auth_key" || return 1
  fi

  if [[ -n $git_name && -n $git_email ]]; then
    run_setup_helper omaterm-setup-git --name "$git_name" --email "$git_email" || return 1
  fi

  if [[ -n $gh_token ]]; then
    run_setup_helper omaterm-setup-github --token "$gh_token" || return 1
  fi

  if [[ -n $ssh_key ]]; then
    run_setup_helper omaterm-setup-ssh --key "$ssh_key" || return 1
  fi

  if [[ -n $op_token ]]; then
    run_setup_helper omaterm-setup-1password --service-token "$op_token" || return 1
  elif [[ -n $op_address && -n $op_email && -n $op_secret_key ]]; then
    run_setup_helper omaterm-setup-1password --account "$op_address" "$op_email" "$op_secret_key" "$op_shorthand" || return 1
  fi
}

gum_confirm() {
  local status interrupted=0

  set +e
  trap 'interrupted=1' INT
  gum confirm "$@"
  status=$?
  trap - INT
  set -e

  if (( interrupted || status == 130 || status > 1 )); then
    SETUP_FINISHED=1
    return 130
  fi

  return "$status"
}

prompt_copy_setup_token() {
  local status

  set +e
  trap : INT
  gum confirm "Copy setup token to clipboard?" --default=false
  status=$?
  trap - INT
  set -e

  if (( status == 0 )); then
    copy_setup_token
  fi
}

copy_setup_token() {
  local setup_json setup_token osc52_token

  setup_json="$(jq -cn \
    --arg git_name "$SETUP_GIT_NAME" \
    --arg git_email "$SETUP_GIT_EMAIL" \
    --arg gh_token "$SETUP_GH_TOKEN" \
    --arg ts_auth_key "$SETUP_TAILSCALE_AUTH_KEY" \
    --arg ssh_key "$SETUP_SSH_KEY" \
    --arg onepassword_token "$SETUP_1PASSWORD_TOKEN" \
    --arg onepassword_address "$SETUP_1PASSWORD_ADDRESS" \
    --arg onepassword_email "$SETUP_1PASSWORD_EMAIL" \
    --arg onepassword_secret_key "$SETUP_1PASSWORD_SECRET_KEY" \
    --arg onepassword_shorthand "$SETUP_1PASSWORD_SHORTHAND" \
    '{
      git: {name: $git_name, email: $git_email},
      github: {token: $gh_token},
      tailscale: {auth_key: $ts_auth_key},
      ssh: {public_key: $ssh_key},
      onepassword: {
        token: $onepassword_token,
        account: {
          address: $onepassword_address,
          email: $onepassword_email,
          secret_key: $onepassword_secret_key,
          shorthand: $onepassword_shorthand
        }
      }
    }')"

  setup_token="$(printf '%s' "$setup_json" | base64 -w0)"
  osc52_token="$(printf '%s' "$setup_token" | base64 -w0)"
  printf '\033]52;c;%s\a' "$osc52_token" >/dev/tty

  echo "✓ Copied setup token to clipboard"
  echo
}

run_setup_helper() {
  local helper="$1" output_file status SETUP_HELPER_MANUAL_PROGRESS=0
  shift

  output_file="$(mktemp)"

  set +e
  "$helper" --output "$output_file" "$@"
  status=$?
  set -e

  if [[ -s $output_file ]]; then
    # shellcheck disable=SC1090
    source "$output_file"
  fi
  (( SETUP_HELPER_MANUAL_PROGRESS )) && SETUP_IN_PROGRESS=1
  rm -f "$output_file"

  if (( status == 130 || status > 1 )); then
    SETUP_FINISHED=1
    return 1
  elif (( status != 0 )); then
    return 1
  fi
}

setup_git_identity() {
  git config --global user.name &>/dev/null && git config --global user.email &>/dev/null && return
  gum_confirm "Identify for Git?" || return 0
  run_setup_helper omaterm-setup-git || return 1
}

setup_gh_authentication() {
  gh auth status &>/dev/null && return
  gum_confirm "Authenticate with GitHub?" || return 0
  run_setup_helper omaterm-setup-github || return 1
}

setup_tailscale() {
  tailscale status &>/dev/null && return
  gum_confirm "Connect to Tailscale?" || return 0
  run_setup_helper omaterm-setup-tailscale || return 1
}

setup_ssh_public_key() {
  gum_confirm "Add SSH public key for remote access?" || return 0
  run_setup_helper omaterm-setup-ssh || return 1
}

setup_1password() {
  gum_confirm "Authenticate with 1Password?" || return 0
  run_setup_helper omaterm-setup-1password || return 1
}

run_setup_section() {
  local label="$1"
  shift

  (( SETUP_FINISHED )) && return 0

  if "$@"; then
    return 0
  fi

  echo
  echo "Skipping $label after an error."
  echo
  SETUP_SECTION_FAILED=1
  return 0
}

run_interactive_setup() {
  run_setup_section "Git identity" setup_git_identity
  run_setup_section "GitHub authentication" setup_gh_authentication
  run_setup_section "Tailscale setup" setup_tailscale
  run_setup_section "SSH key setup" setup_ssh_public_key
  run_setup_section "1Password authentication" setup_1password
}

finish_setup() {
  mkdir -p "$(dirname "$SETUP_DONE_MARKER")"
  touch "$SETUP_DONE_MARKER"

  echo
  if (( SETUP_UNATTENDED )); then
    return
  elif [ -t 0 ] && [ -r /dev/tty ]; then
    if (( SETUP_IN_PROGRESS )); then
      prompt_copy_setup_token
    fi
    gum spin --spinner "globe" --title "Setup complete. Press any key to tmux..." -- bash -c 'read -n 1 -s </dev/tty'
  else
    echo "Setup complete"
  fi
}

if [[ -n ${OMATERM_SETUP_TOKEN:-} ]]; then
  if decode_setup_token "$OMATERM_SETUP_TOKEN"; then
    run_setup_section "Setup token" apply_setup_token
    if [[ -n ${OMATERM_TS_HOSTNAME:-} ]] && (( ! SETUP_SECTION_FAILED )); then
      SETUP_UNATTENDED=1
    fi
  fi
else
  banner
  run_interactive_setup
fi

finish_setup
