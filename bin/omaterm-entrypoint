#!/usr/bin/env bash
set -euo pipefail

TAILSCALE_STATE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_SOCKET="/var/run/tailscale/tailscaled.sock"
HOST_DOCKER_SOCKET="/var/run/docker.sock"

ensure_sudo_password_is_set() {
  if ! grep -q NOPASSWD /etc/sudoers.d/omaterm 2>/dev/null; then
    return
  fi

  if [ ! -t 0 ]; then
    echo "Error: First-run Docker setup needs an interactive terminal to set the omaterm sudo password."
    echo "Run with: docker run -it --name omaterm --network host -v /var/run/docker.sock:/var/run/docker.sock ghcr.io/omacom-io/omaterm"
    exit 1
  fi

  echo "Set a sudo password for omaterm."
  until passwd omaterm; do
    echo "Password setup failed. Try again."
  done

  printf "omaterm ALL=(ALL) ALL\n" > /etc/sudoers.d/omaterm
  chmod 0440 /etc/sudoers.d/omaterm
  echo
}


tailscaled_running() {
  local comm

  for comm in /proc/[0-9]*/comm; do
    [ "$(cat "$comm" 2>/dev/null || true)" = "tailscaled" ] && return 0
  done

  return 1
}

start_tailscaled() {
  command -v tailscaled &>/dev/null || return 0

  mkdir -p "$(dirname "$TAILSCALE_SOCKET")" "$(dirname "$TAILSCALE_STATE")"

  local tun_args=(--tun=userspace-networking)
  if [ -w /dev/net/tun ]; then
    tun_args=()
  fi

  if ! tailscaled_running; then
    rm -f "$TAILSCALE_SOCKET"
    tailscaled \
      "${tun_args[@]}" \
      --state="$TAILSCALE_STATE" \
      --socket="$TAILSCALE_SOCKET" \
      >/var/log/tailscaled.log 2>&1 &
  fi
}

ensure_host_docker_access() {
  [ -S "$HOST_DOCKER_SOCKET" ] || return 0

  local socket_gid group_name

  socket_gid="$(stat -c '%g' "$HOST_DOCKER_SOCKET")"
  group_name="$(getent group "$socket_gid" | cut -d: -f1 || true)"

  if [ -z "$group_name" ]; then
    if getent group docker &>/dev/null; then
      group_name="docker-host"
    else
      group_name="docker"
    fi

    if getent group "$group_name" &>/dev/null; then
      group_name="docker-$socket_gid"
    fi

    groupadd -g "$socket_gid" "$group_name"
  fi

  usermod -aG "$group_name" omaterm
}

ensure_sudo_password_is_set
printf "omaterm ALL=(root) NOPASSWD: /usr/bin/tailscale\n" >/etc/sudoers.d/omaterm-tailscale
chmod 0440 /etc/sudoers.d/omaterm-tailscale
ensure_host_docker_access
start_tailscaled

OMATERM_ENV=(
  HOME=/home/omaterm
  USER=omaterm
  LOGNAME=omaterm
  SHELL=/bin/bash
  TERM="${TERM:-xterm-256color}"
  OMATERM_DOCKER=1
  PATH="/home/omaterm/.local/share/mise/shims:/home/omaterm/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
)

SETUP_ENV=("${OMATERM_ENV[@]}")
if [ -n "${OMATERM_SETUP_TOKEN:-}" ]; then
  SETUP_ENV+=(OMATERM_SETUP_TOKEN="$OMATERM_SETUP_TOKEN")
fi
if [ -n "${OMATERM_TS_HOSTNAME:-}" ]; then
  SETUP_ENV+=(OMATERM_TS_HOSTNAME="$OMATERM_TS_HOSTNAME")
fi

runuser -u omaterm -- env "${SETUP_ENV[@]}" /home/omaterm/.local/bin/omaterm-setup

exec runuser -u omaterm -- env "${OMATERM_ENV[@]}" bash -l "$@"
