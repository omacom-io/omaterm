#!/usr/bin/env bash
set -euo pipefail

TAILSCALE_STATE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_SOCKET="/var/run/tailscale/tailscaled.sock"

tailscaled_running() {
  local comm

  for comm in /proc/[0-9]*/comm; do
    [ "$(cat "$comm" 2>/dev/null || true)" = "tailscaled" ] && return 0
  done

  return 1
}

start_tailscaled_if_configured() {
  command -v tailscaled &>/dev/null || return 0
  [ -e "$TAILSCALE_STATE" ] || return 0

  mkdir -p "$(dirname "$TAILSCALE_SOCKET")" "$(dirname "$TAILSCALE_STATE")"

  if ! tailscaled_running; then
    rm -f "$TAILSCALE_SOCKET"
    tailscaled \
      --tun=userspace-networking \
      --state="$TAILSCALE_STATE" \
      --socket="$TAILSCALE_SOCKET" \
      >/var/log/tailscaled.log 2>&1 &
  fi
}

setup_docker_socket_access() {
  local docker_gid

  [ -S /var/run/docker.sock ] || return 0

  docker_gid="$(stat -c "%g" /var/run/docker.sock)"

  if getent group docker &>/dev/null; then
    groupmod -o -g "$docker_gid" docker
  else
    groupadd -o -g "$docker_gid" docker
  fi

  usermod -aG docker omaterm
}

/home/omaterm/.local/bin/omaterm-setup-sudopw
setup_docker_socket_access
start_tailscaled_if_configured

OMATERM_ENV=(
  HOME=/home/omaterm
  USER=omaterm
  LOGNAME=omaterm
  SHELL=/bin/bash
  TERM="${TERM:-xterm-256color}"
  OMATERM_DOCKER=1
  PATH="/home/omaterm/.local/share/mise/shims:/home/omaterm/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
)

run_as_omaterm() {
  runuser -u omaterm -- env "${OMATERM_ENV[@]}" "$@"
}

run_as_omaterm /home/omaterm/.local/bin/omaterm-setup

exec runuser -u omaterm -- env "${OMATERM_ENV[@]}" bash -l "$@"
