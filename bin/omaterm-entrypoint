#!/usr/bin/env bash
set -euo pipefail

TAILSCALE_STATE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_SOCKET="/var/run/tailscale/tailscaled.sock"
DIND_SOCKET="/var/run/omaterm-docker.sock"
DIND_HOST="unix://$DIND_SOCKET"

tailscaled_running() {
  local comm

  for comm in /proc/[0-9]*/comm; do
    [ "$(cat "$comm" 2>/dev/null || true)" = "tailscaled" ] && return 0
  done

  return 1
}

start_tailscaled_if_configured() {
  command -v tailscaled &>/dev/null || return 0
  [ -e "$TAILSCALE_STATE" ] || return 0

  mkdir -p "$(dirname "$TAILSCALE_SOCKET")" "$(dirname "$TAILSCALE_STATE")"

  local tun_args=(--tun=userspace-networking)
  if [ -w /dev/net/tun ]; then
    tun_args=()
  fi

  if ! tailscaled_running; then
    rm -f "$TAILSCALE_SOCKET"
    tailscaled \
      "${tun_args[@]}" \
      --state="$TAILSCALE_STATE" \
      --socket="$TAILSCALE_SOCKET" \
      >/var/log/tailscaled.log 2>&1 &
  fi
}

# Give the docker group a real, non-zero GID and own the DinD socket with it.
# Creating the group *before* dockerd (and passing --group docker) means the
# socket is created root:docker; otherwise dockerd falls back to root:root and
# we'd have to map the docker group onto GID 0, granting omaterm the root group.
ensure_docker_group() {
  getent group docker &>/dev/null || groupadd docker
  usermod -aG docker omaterm
}

dockerd_responding() {
  docker --host "$DIND_HOST" info &>/dev/null
}

# Prefer overlay2 (copy-on-write) and only fall back to the slow, disk-heavy
# vfs driver when faster drivers fail to start (e.g. overlay-on-overlay).
DIND_STORAGE_DRIVERS=(overlay2 fuse-overlayfs vfs)

start_dind() {
  mkdir -p /var/lib/docker "$(dirname "$DIND_SOCKET")"

  dockerd_responding && return 0

  ensure_docker_group

  local driver dockerd_pid i
  for driver in "${DIND_STORAGE_DRIVERS[@]}"; do
    if [ "$driver" = "fuse-overlayfs" ] && ! command -v fuse-overlayfs &>/dev/null; then
      continue
    fi

    rm -f "$DIND_SOCKET"
    dockerd --host "$DIND_HOST" --group docker --storage-driver="$driver" \
      >/var/log/dockerd.log 2>&1 &
    dockerd_pid=$!

    for i in {1..30}; do
      if dockerd_responding; then
        echo "Docker-in-Docker started with storage driver: $driver" >&2
        return 0
      fi
      # Stop waiting early if dockerd already exited so we can try the next driver.
      kill -0 "$dockerd_pid" 2>/dev/null || break
      sleep 1
    done

    kill "$dockerd_pid" 2>/dev/null || true
    wait "$dockerd_pid" 2>/dev/null || true
  done

  echo "Error: Docker-in-Docker daemon did not start." >&2
  tail -50 /var/log/dockerd.log >&2 || true
  exit 1
}

/home/omaterm/.local/bin/omaterm-setup-sudopw
start_dind
start_tailscaled_if_configured

OMATERM_ENV=(
  HOME=/home/omaterm
  USER=omaterm
  LOGNAME=omaterm
  SHELL=/bin/bash
  TERM="${TERM:-xterm-256color}"
  OMATERM_DOCKER=1
  DOCKER_HOST="$DIND_HOST"
  PATH="/home/omaterm/.local/share/mise/shims:/home/omaterm/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
)

run_as_omaterm() {
  runuser -u omaterm -- env "${OMATERM_ENV[@]}" "$@"
}

run_as_omaterm /home/omaterm/.local/bin/omaterm-setup

exec runuser -u omaterm -- env "${OMATERM_ENV[@]}" bash -l "$@"
