#!/usr/bin/env bash
set -euo pipefail

OUTPUT_FILE=""
MODE=""
SERVICE_TOKEN=""
ADDRESS=""
EMAIL=""
SECRET_KEY=""
SHORTHAND=""
SETUP_HELPER_MANUAL_PROGRESS=0

usage() {
  echo "Usage: omaterm-setup-1password --output FILE [--service-token TOKEN|--account ADDRESS EMAIL SECRET_KEY SHORTHAND]" >&2
}

while (($#)); do
  case "$1" in
    --output)
      OUTPUT_FILE="${2:-}"
      shift 2
      ;;
    --service-token)
      SERVICE_TOKEN="${2:-}"
      shift 2
      ;;
    --account)
      MODE="account"
      ADDRESS="${2:-}"
      EMAIL="${3:-}"
      SECRET_KEY="${4:-}"
      SHORTHAND="${5:-}"
      shift 5
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ -n $OUTPUT_FILE ]] || {
  usage
  exit 2
}

write_output() {
  {
    printf 'SETUP_1PASSWORD_TOKEN=%q\n' "${SETUP_1PASSWORD_TOKEN:-}"
    printf 'SETUP_1PASSWORD_ADDRESS=%q\n' "${SETUP_1PASSWORD_ADDRESS:-}"
    printf 'SETUP_1PASSWORD_EMAIL=%q\n' "${SETUP_1PASSWORD_EMAIL:-}"
    printf 'SETUP_1PASSWORD_SECRET_KEY=%q\n' "${SETUP_1PASSWORD_SECRET_KEY:-}"
    printf 'SETUP_1PASSWORD_SHORTHAND=%q\n' "${SETUP_1PASSWORD_SHORTHAND:-}"
    printf 'SETUP_HELPER_MANUAL_PROGRESS=%q\n' "$SETUP_HELPER_MANUAL_PROGRESS"
  } >"$OUTPUT_FILE"
}

finish_from_interrupt() {
  write_output
  exit 130
}

gum_input_into() {
  local -n target="$1"
  local value status
  shift

  set +e
  trap : INT
  value="$(gum input "$@")"
  status=$?
  trap - INT
  set -e

  if (( status != 0 )); then
    target=""
    finish_from_interrupt
  fi

  target="$value"
  if [[ -n $value ]]; then
    SETUP_HELPER_MANUAL_PROGRESS=1
    write_output
  fi
}

gum_choose_into() {
  local -n target="$1"
  local value status
  shift

  set +e
  trap : INT
  value="$(gum choose "$@")"
  status=$?
  trap - INT
  set -e

  if (( status != 0 )); then
    target=""
    finish_from_interrupt
  fi

  target="$value"
  if [[ -n $value ]]; then
    SETUP_HELPER_MANUAL_PROGRESS=1
    write_output
  fi
}

setup_service_token() {
  local token="${1:-}"

  while [[ -z $token ]]; do
    gum_input_into token --password --placeholder "ops_eyJasf..." --prompt "1Password service token: " || return 1
  done

  export OP_SERVICE_ACCOUNT_TOKEN="$token"
  op whoami &>/dev/null || return 1

  SETUP_1PASSWORD_TOKEN="$token"
  write_output

  echo "✓ 1Password"
  echo
}

setup_full_account() {
  local address="${1:-}" email="${2:-}" secret_key="${3:-}" shorthand="${4:-}" password="" session

  while [[ -z $address ]]; do
    gum_input_into address --prompt "1Password sign-in address: " || return 1
  done

  while [[ -z $email ]]; do
    gum_input_into email --prompt "1Password email: " || return 1
  done

  while [[ -z $secret_key ]]; do
    gum_input_into secret_key --password --prompt "1Password secret key: " || return 1
  done

  if (($# == 0)); then
    gum_input_into shorthand --prompt "1Password account shorthand (optional): " || return 1
  fi

  while [[ -z $password ]]; do
    gum_input_into password --password --prompt "1Password password: " || return 1
  done

  if ! op account list --format json 2>/dev/null | jq -e 'length > 0' >/dev/null; then
    local account_args=(account add --address "$address" --email "$email" --secret-key "$secret_key" --signin)

    if [[ -n $shorthand ]]; then
      account_args+=(--shorthand "$shorthand")
    fi

    session="$(printf '%s\n' "$password" | op "${account_args[@]}")" || return 1
  else
    local signin_args=(signin)

    if [[ -n $shorthand ]]; then
      signin_args+=(--account "$shorthand")
    elif [[ -n $address ]]; then
      signin_args+=(--account "$address")
    fi

    session="$(printf '%s\n' "$password" | op "${signin_args[@]}")" || return 1
  fi

  eval "$session"

  SETUP_1PASSWORD_ADDRESS="$address"
  SETUP_1PASSWORD_EMAIL="$email"
  SETUP_1PASSWORD_SECRET_KEY="$secret_key"
  SETUP_1PASSWORD_SHORTHAND="$shorthand"
  write_output

  echo "✓ 1Password"
  echo
}

if [[ -n $SERVICE_TOKEN ]]; then
  setup_service_token "$SERVICE_TOKEN"
  exit
fi

if op whoami &>/dev/null; then
  write_output
  exit 0
fi

if [[ $MODE == account ]]; then
  setup_full_account "$ADDRESS" "$EMAIL" "$SECRET_KEY" "$SHORTHAND"
  exit
fi

auth_method=""
gum_choose_into auth_method --header "Choose 1password authentication" "Use service token" "Use full account details" || exit 1

case "$auth_method" in
  "Use service token")
    setup_service_token
    ;;
  "Use full account details")
    setup_full_account
    ;;
  *)
    exit 1
    ;;
esac
