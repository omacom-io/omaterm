#!/usr/bin/env bash
set -euo pipefail

IMAGE="${OMATERM_IMAGE:-ghcr.io/omacom-io/omaterm}"
DEFAULT_NAME="omaterm"
LABEL="omaterm=1"
PREPARE_DONE_MARKER="/home/omaterm/.local/state/omaterm/prepare-done"
SETUP_DONE_MARKER="/home/omaterm/.local/state/omaterm/setup-done"
TAILSCALE_STATE_FILE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_HOSTNAME_FILE="/home/omaterm/.local/state/omaterm/tailscale-hostname"

# Resource limits, templates, and the 1Password loader live in sibling files to
# keep this one lean. install.sh ships the whole bin/host directory together, so
# they resolve next to this script wherever omaterm runs.
OMATERM_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/host/omaterm-limits
source "$OMATERM_LIB_DIR/omaterm-limits"
# shellcheck source=bin/host/omaterm-templates
source "$OMATERM_LIB_DIR/omaterm-templates"
# shellcheck source=bin/host/omaterm-op
source "$OMATERM_LIB_DIR/omaterm-op"

usage() {
  cat >&2 <<'EOF'
Usage:
  omaterm
  omaterm new NAME [-t|--template TEMPLATE] [-d|--docker-access]
    [-p|--prepare COMMAND] [--op ITEM]
    [--git-name NAME] [--git-email EMAIL] [--gh-token TOKEN]
    [--ts-token TOKEN] [--ts-host HOSTNAME] [--op-token TOKEN]
    [--ssh-key PUBLIC_KEY]
  omaterm template create NAME --from SOURCE
  omaterm template ls
  omaterm template rm NAME
  omaterm connect [NAME]
  omaterm ls
  omaterm exec NAME [-w|--workdir DIR] COMMAND...
  omaterm rm [-a|NAME]
EOF
}

validate_name() {
  local name="$1"

  if [[ ! $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
    echo "Invalid Omaterm name: $name" >&2
    echo "Use letters, numbers, dots, underscores, and hyphens." >&2
    exit 2
  fi
}

omaterm_names() {
  docker container ls -a --filter "label=$LABEL" --format '{{.Names}}' | sort -u
}

container_exists() {
  docker container inspect "$1" >/dev/null 2>&1
}

container_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$1")" == "true" ]]
}

# The docker socket is group-owned by `docker`. After the installer adds the
# user to that group, shells started earlier still lack the GID until they
# re-login, so docker calls fail with a permission error. If the user is a
# member per /etc/group but this process didn't inherit the GID, re-exec under
# the group with sg so omaterm works without a logout. The GID check is the
# fast path: when it's already present (the normal case) we return immediately
# without touching docker.
ensure_docker_group() {
  local docker_gid
  docker_gid="$(getent group docker | cut -d: -f3)"

  [[ -n $docker_gid ]] || return 0
  id -G | grep -qw "$docker_gid" && return 0   # already have it: nothing to do
  id -nG | grep -qw docker || return 0         # not a member: can't fix it here
  command -v sg >/dev/null 2>&1 || return 0    # no sg: fall through to the real error
  docker info >/dev/null 2>&1 && return 0      # reachable anyway: don't re-exec

  exec sg docker -c "$(printf '%q ' "$0" "$@")"
}

choose_omaterm() {
  local action="$1"
  shift

  if (($# == 0)); then
    return 1
  elif (($# == 1)); then
    printf '%s\n' "$1"
    return
  fi

  if command -v gum >/dev/null 2>&1 && [ -t 0 ]; then
    printf '%s\n' "$@" | gum choose --header "$action Omaterm"
    return
  fi

  if [ -t 0 ] && [ -r /dev/tty ]; then
    local index choice

    echo "$action Omaterm:" >/dev/tty
    index=1
    for choice in "$@"; do
      printf '  %d) %s\n' "$index" "$choice" >/dev/tty
      index=$((index + 1))
    done

    while true; do
      read -r -p "> " choice </dev/tty
      if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= $# )); then
        printf '%s\n' "${!choice}"
        return
      fi
    done
  fi

  echo "Multiple Omaterm containers found. Re-run from an interactive terminal." >&2
  return 1
}

# Tailscale hostname derived from the host and Omaterm name ("<host>-<name>",
# e.g. dhh-fd-bokka-bc3), reduced to the letters/numbers/hyphens Tailscale allows
# and capped at its 63-character limit.
host_ts_hostname() {
  local raw="$(hostname)-$1"
  raw="$(printf '%s' "$raw" | tr -c 'a-zA-Z0-9-' '-' | sed -E 's/-+/-/g; s/^-+//; s/-+$//')"
  printf '%s' "${raw:0:63}"
}

wait_for_prepare() {
  local name="$1" status

  while true; do
    # The marker holds the prepare command's exit status once it finishes.
    if status="$(docker exec "$name" cat "$PREPARE_DONE_MARKER" 2>/dev/null)"; then
      if [[ $status == 0 ]]; then
        return 0
      fi

      echo "Omaterm prepare failed for $name with exit status $status." >&2
      return "$status"
    fi

    # No marker yet: if the container has already died, prepare never finished.
    if ! container_running "$name"; then
      echo "Omaterm prepare failed for $name." >&2
      return 1
    fi

    sleep 1
  done
}

run_new() {
  local name="" template="" tailscale_host="" mount_docker=0 prepare=0 status
  local setup_op="" overrides=0 image reset_cmd
  local git_name="" git_email="" gh_token="" ts_token="" op_token="" ssh_key=""
  local prepare_command=""
  local docker_args=() env_args=() name_args=() command_args=() all=() new_index=0 i

  while (($#)); do
    case "$1" in
      -t | --template)      template="${2:-}"; shift 2 ;;
      --op)                 setup_op="${2:-}"; overrides=1; shift 2 ;;
      -p | --prepare)       prepare=1; prepare_command="${2:-}"; shift 2 ;;
      --ts-host)            tailscale_host="${2:-}"; overrides=1; shift 2 ;;
      --git-name)           git_name="${2:-}"; overrides=1; shift 2 ;;
      --git-email)          git_email="${2:-}"; overrides=1; shift 2 ;;
      --gh-token)           gh_token="${2:-}"; overrides=1; shift 2 ;;
      --ts-token)           ts_token="${2:-}"; overrides=1; shift 2 ;;
      --op-token)           op_token="${2:-}"; overrides=1; shift 2 ;;
      --ssh-key)            ssh_key="${2:-}"; overrides=1; shift 2 ;;
      -d | --docker-access) mount_docker=1; shift ;;
      -*)                   usage; exit 2 ;;
      *)                    name="$1"; shift ;;
    esac
  done

  if [[ -n $setup_op ]]; then
    load_setup_from_op "$setup_op"
  fi

  if [[ -z $name ]]; then
    usage
    exit 2
  fi

  if [[ -n $template && $prepare == 1 ]]; then
    echo "Error: --prepare cannot be combined with --template." >&2
    exit 2
  fi

  validate_name "$name"

  # With a Tailscale auth key but no explicit hostname, name the node after the
  # host and the box (dhh-fd-bokka-bc3) so an unattended bring-up is identifiable.
  if [[ -n $ts_token && -z $tailscale_host ]]; then
    tailscale_host="$(host_ts_hostname "$name")"
  fi

  # A hostname can't register a fresh node on its own — Tailscale needs an auth
  # key. Fail here with a clear message instead of a container that exits during
  # setup when omaterm-setup-tailscale can't bring the node up.
  if [[ -n $tailscale_host && -z $ts_token ]]; then
    echo "Error: --ts-host needs --ts-token (a new Omaterm registers a fresh Tailscale node)." >&2
    exit 2
  fi

  if container_exists "$name"; then
    echo "Omaterm already exists: $name" >&2
    exit 1
  fi

  if [[ -n $template ]]; then
    validate_name "$template"
    image="$TEMPLATE_IMAGE_REPO:$template"
    docker image inspect "$image" >/dev/null 2>&1 || {
      echo "No such template: $template" >&2
      echo "Create one first: omaterm template create $template --from SOURCE" >&2
      echo "List templates with: omaterm template ls" >&2
      exit 1
    }
  else
    image="$IMAGE"
  fi

  name_args=(--name "$name")

  # Adding this Omaterm re-slices CPU and shrinks every Omaterm's memory share.
  # Build the full ordered set (existing Omaterms plus this one), re-divide the
  # existing ones, then claim this Omaterm's own slice by its position in the set.
  mapfile -t all < <(omaterm_names; echo "$name")
  mapfile -t all < <(printf '%s\n' "${all[@]}" | sort -u)
  for i in "${!all[@]}"; do
    [[ ${all[i]} == "$name" ]] && new_index="$i"
  done
  rebalance_limits "${all[@]}"
  build_limit_args "${#all[@]}" "$new_index"

  if [ -t 0 ] && [ -r /dev/tty ]; then
    exec </dev/tty
  fi

  if (( mount_docker )); then
    docker_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
  fi

  if [[ -n $template ]]; then
    # The template image bakes in the source's setup env (tokens) and Tailscale
    # node identity. Pass every setup var explicitly — empty unless overridden —
    # so the baked-in env can't silently re-apply. Always wipe the Tailscale
    # state and clear the setup marker: every box stamped from a template is its
    # own machine, so it must register a fresh Tailscale node (not fight the
    # source over one identity) and re-run setup to apply its own --ts-host/token.
    env_args=(
      -e "OMATERM_SETUP_TS_HOST=$tailscale_host"
      -e "OMATERM_SETUP_GIT_NAME=$git_name"
      -e "OMATERM_SETUP_GIT_EMAIL=$git_email"
      -e "OMATERM_SETUP_GH_TOKEN=$gh_token"
      -e "OMATERM_SETUP_TS_AUTH_KEY=$ts_token"
      -e "OMATERM_SETUP_OP_TOKEN=$op_token"
      -e "OMATERM_SETUP_SSH_KEY=$ssh_key"
    )

    reset_cmd="rm -f $TAILSCALE_STATE_FILE $TAILSCALE_HOSTNAME_FILE $SETUP_DONE_MARKER; "

    exec docker run -it "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      --entrypoint bash \
      "$image" \
      -c "${reset_cmd}exec /home/omaterm/.local/bin/omaterm-entrypoint"
  fi

  [[ -n $tailscale_host ]] && env_args+=(-e "OMATERM_SETUP_TS_HOST=$tailscale_host")
  [[ -n $git_name ]] && env_args+=(-e "OMATERM_SETUP_GIT_NAME=$git_name")
  [[ -n $git_email ]] && env_args+=(-e "OMATERM_SETUP_GIT_EMAIL=$git_email")
  [[ -n $gh_token ]] && env_args+=(-e "OMATERM_SETUP_GH_TOKEN=$gh_token")
  [[ -n $ts_token ]] && env_args+=(-e "OMATERM_SETUP_TS_AUTH_KEY=$ts_token")
  [[ -n $op_token ]] && env_args+=(-e "OMATERM_SETUP_OP_TOKEN=$op_token")
  [[ -n $ssh_key ]] && env_args+=(-e "OMATERM_SETUP_SSH_KEY=$ssh_key")

  if (( prepare )); then
    # Run the prepare command once, recording its exit status to the marker
    # whether it succeeds or fails. The container then drops to an interactive
    # login shell either way, so a failed prepare stays attachable for
    # inspection while wait_for_prepare can still tell it apart from success.
    command_args=(-c "if [ ! -f $PREPARE_DONE_MARKER ]; then mkdir -p $(dirname "$PREPARE_DONE_MARKER"); if $prepare_command; then s=0; else s=\$?; fi; echo \$s >$PREPARE_DONE_MARKER.tmp && mv $PREPARE_DONE_MARKER.tmp $PREPARE_DONE_MARKER; fi; exec bash -l")

    set +e
    docker run -dit "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      "$IMAGE" \
      "${command_args[@]}" >/dev/null
    status=$?
    set -e

    (( status == 0 )) || exit "$status"

    echo "==> Preparing $name..." >&2
    wait_for_prepare "$name"
    exit "$?"
  else
    exec docker run -it "${env_args[@]}" \
      "${name_args[@]}" \
      --label "$LABEL" \
      --net host \
      "${LIMIT_ARGS[@]}" \
      "${docker_args[@]}" \
      "$IMAGE" \
      "${command_args[@]}"
  fi
}

connect_omaterm() {
  local name="$1"

  if container_running "$name"; then
    exec docker attach "$name"
  else
    exec docker start -ai "$name"
  fi
}

run_connect() {
  local name="${1:-}" names

  if [[ -n $name ]]; then
    validate_name "$name"
    container_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }

    mapfile -t names < <(omaterm_names)
    rebalance_limits "${names[@]}"
    connect_omaterm "$name"
  fi

  mapfile -t names < <(omaterm_names)

  if ((${#names[@]} == 0)); then
    run_new "$DEFAULT_NAME" -d
  fi

  name="$(choose_omaterm "Start" "${names[@]}")"

  rebalance_limits "${names[@]}"

  connect_omaterm "$name"
}

# Prepare state for an Omaterm: "ready"/"failed (N)"/"preparing" for prepared ones,
# "-" for plain interactive ones. The marker holds the prepare exit status and
# can only be read while the container is running.
prepare_status() {
  local name="$1" state="$2" code

  if ! docker inspect -f '{{json .Config.Cmd}}' "$name" 2>/dev/null | grep -q "$PREPARE_DONE_MARKER"; then
    echo "-"
  elif [[ $state != running ]]; then
    echo "stopped"
  elif code="$(docker exec "$name" cat "$PREPARE_DONE_MARKER" 2>/dev/null)"; then
    [[ $code == 0 ]] && echo "ready" || echo "failed ($code)"
  else
    echo "preparing"
  fi
}

run_ls() {
  local names name state mem_bytes mem
  mapfile -t names < <(omaterm_names)
  ((${#names[@]})) || return 0

  {
    printf 'NAME\tSTATUS\tMEMORY\tPREPARE\n'
    for name in "${names[@]}"; do
      state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo '?')"

      mem_bytes="$(docker inspect -f '{{.HostConfig.Memory}}' "$name" 2>/dev/null || echo 0)"
      if [[ $mem_bytes =~ ^[0-9]+$ ]] && ((mem_bytes > 0)); then
        mem="$((mem_bytes / 1024 / 1024))m"
      else
        mem="unlimited"
      fi

      printf '%s\t%s\t%s\t%s\n' "$name" "$state" "$mem" "$(prepare_status "$name" "$state")"
    done
  } | column -t -s "$(printf '\t')"
}

run_exec() {
  local name="$1" command workdir="" docker_args=()
  shift

  validate_name "$name"
  container_exists "$name" || {
    echo "No such Omaterm: $name" >&2
    exit 1
  }

  if [[ ${1:-} == "--" ]]; then
    shift
  fi

  while (($#)); do
    case "$1" in
      -w | --workdir)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        workdir="${2:-}"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  (($#)) || {
    usage
    exit 2
  }

  command="$*"
  [[ -n $workdir ]] && docker_args+=(-w "$workdir")

  if ! container_running "$name"; then
    docker start "$name" >/dev/null
  fi

  exec docker exec "${docker_args[@]}" "$name" bash -lc "$command"
}

# Reclaim dangling (untagged) images left behind by replaced templates or
# rebuilt base images. Only touches images no container references, so live
# Omaterms, templates, and their base images are safe.
prune_dangling_images() {
  docker image prune -f >/dev/null 2>&1 || true
}

run_rm() {
  local names name="${1:-}"

  if [[ $name == "-a" ]]; then
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    docker rm -f "${names[@]}"
    prune_dangling_images
    return
  elif [[ -n $name ]]; then
    validate_name "$name"
    container_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }
  else
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    name="$(choose_omaterm "Remove" "${names[@]}")"
  fi

  docker rm -f "$name"
  prune_dangling_images

  # One fewer Omaterm means a larger CPU slice and memory share for the rest.
  mapfile -t names < <(omaterm_names)
  rebalance_limits "${names[@]}"
}

ensure_docker_group "$@"

case "${1:-}" in
  "")       run_connect ;;
  new)      run_new "${@:2}" ;;
  template) run_template "${@:2}" ;;
  connect)  run_connect "${2:-}" ;;
  ls)       run_ls ;;
  exec)     run_exec "${@:2}" ;;
  rm)       run_rm "${2:-}" ;;
  -h)       usage ;;
  *)
    usage
    exit 2
    ;;
esac
