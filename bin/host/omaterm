#!/usr/bin/env bash
set -euo pipefail

IMAGE="${OMATERM_IMAGE:-ghcr.io/omacom-io/omaterm}"
DEFAULT_NAME="omaterm"
LABEL="omaterm=1"
# Marks an Omaterm that opted out of resource limits: it runs uncapped and is
# excluded from every division and rebalance.
NOLIMITS_LABEL="omaterm.nolimits=1"
SETUP_DONE_MARKER="/home/omaterm/.local/state/omaterm/setup-done"
TAILSCALE_STATE_FILE="/var/lib/tailscale/tailscaled.state"
TAILSCALE_HOSTNAME_FILE="/home/omaterm/.local/state/omaterm/tailscale-hostname"

# Resource limits, templates, and the 1Password loader live in sibling files to
# keep this one lean. install.sh ships the whole bin/host directory together, so
# they resolve next to this script wherever omaterm runs.
OMATERM_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$OMATERM_LIB_DIR/omaterm-limits"
source "$OMATERM_LIB_DIR/omaterm-templates"
source "$OMATERM_LIB_DIR/omaterm-op"

usage() {
  cat >&2 <<'EOF'
Usage:
  omaterm
  omaterm new NAME [-t|--template TEMPLATE] [-d|--docker-access] [-n|--no-limits]
    [--detach]
    [--op ITEM]
    [--git-name NAME] [--git-email EMAIL] [--gh-token TOKEN]
    [--ts-token TOKEN] [--ts-host HOSTNAME] [--op-token TOKEN]
    [--ssh-key PUBLIC_KEY]
  omaterm template create NAME --from SOURCE
  omaterm template ls
  omaterm template rm NAME
  omaterm connect [NAME]
  omaterm ls
  omaterm exec NAME [-w|--workdir DIR] COMMAND...
  omaterm rm [-a|NAME]
EOF
}

validate_name() {
  local name="$1"

  if [[ ! $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
    echo "Invalid Omaterm name: $name" >&2
    echo "Use letters, numbers, dots, underscores, and hyphens." >&2
    exit 2
  fi
}

omaterm_names() {
  docker container ls -a --filter "label=$LABEL" --format '{{.Names}}' | sort -u
}

# Omaterms tagged to sit out the limits game.
omaterm_nolimits_names() {
  docker container ls -a --filter "label=$LABEL" --filter "label=$NOLIMITS_LABEL" --format '{{.Names}}' | sort -u
}

# Omaterms that take part in resource division — every Omaterm minus the opt-outs.
omaterm_limited_names() {
  comm -23 <(omaterm_names) <(omaterm_nolimits_names)
}

container_exists() {
  docker container inspect "$1" >/dev/null 2>&1
}

# True only for containers omaterm created (carrying its label), so commands
# like `omaterm rm NAME` can never touch unrelated containers.
omaterm_exists() {
  omaterm_names | grep -qxF "$1"
}

container_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$1")" == "true" ]]
}

container_detached() {
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$1" 2>/dev/null |
    grep -qxF 'OMATERM_DETACH=1'
}

# The docker socket is group-owned by `docker`. After the installer adds the
# user to that group, shells started earlier still lack the GID until they
# re-login. If this process doesn't have the GID yet, run the requested omaterm
# command in a docker-group shell.
ensure_docker_group() {
  local docker_gid cmd

  docker_gid="$(getent group docker | cut -d: -f3)"

  [[ -n $docker_gid ]] || return 0
  id -G | grep -qw "$docker_gid" && return 0

  cmd="$(printf '%q ' "$0" "$@")"
  if command -v sg >/dev/null 2>&1; then
    exec sg docker -c "$cmd"
  else
    # Some distros (e.g. Arch, where util-linux absorbed newgrp/su/login from
    # shadow but not sg) no longer ship sg. util-linux's newgrp supports the
    # same -c flag, so fall back to it.
    exec newgrp docker -c "$cmd"
  fi
}

choose_omaterm() {
  local action="$1"
  shift

  if (($# == 0)); then
    return 1
  elif (($# == 1)); then
    printf '%s\n' "$1"
    return
  fi

  if command -v gum >/dev/null 2>&1 && [ -t 0 ]; then
    printf '%s\n' "$@" | gum choose --header "$action Omaterm"
    return
  fi

  echo "Multiple Omaterm containers found. Re-run from an interactive terminal." >&2
  return 1
}

# Tailscale hostname derived from the host and Omaterm name ("<host>-<name>",
# e.g. dhh-fd-bokka-bc3), reduced to the letters/numbers/hyphens Tailscale allows
# and capped at its 63-character limit.
host_ts_hostname() {
  local raw="$(hostname)-$1"
  raw="$(printf '%s' "$raw" | tr -c 'a-zA-Z0-9-' '-' | sed -E 's/-+/-/g; s/^-+//; s/-+$//')"
  raw="${raw:0:63}"
  # The cap can land right after a hyphen, and a DNS label can't end with one.
  printf '%s' "${raw%-}"
}

run_new() {
  local name="" template="" tailscale_host="" mount_docker=0 no_limits=0 detach=0
  local setup_op="" image run_mode detach_env pair var image_run
  local git_name="" git_email="" gh_token="" ts_token="" op_token="" ssh_key=""
  local docker_args=() env_args=() name_args=() label_args=() limited=() all=() new_index=0 i

  while (($#)); do
    case "$1" in
      # A value-taking flag without its value would die as a silent set -e
      # shift failure; catch it here (;;& falls through to the real arm).
      -t | --template | --op | --ts-host | --git-name | --git-email | \
        --gh-token | --ts-token | --op-token | --ssh-key)
        (($# >= 2)) || { usage; exit 2; } ;;&
      -t | --template)      template="${2:-}"; shift 2 ;;
      --op)                 setup_op="${2:-}"; shift 2 ;;
      --ts-host)            tailscale_host="${2:-}"; shift 2 ;;
      --git-name)           git_name="${2:-}"; shift 2 ;;
      --git-email)          git_email="${2:-}"; shift 2 ;;
      --gh-token)           gh_token="${2:-}"; shift 2 ;;
      --ts-token)           ts_token="${2:-}"; shift 2 ;;
      --op-token)           op_token="${2:-}"; shift 2 ;;
      --ssh-key)            ssh_key="${2:-}"; shift 2 ;;
      -d | --docker-access) mount_docker=1; shift ;;
      -n | --no-limits)     no_limits=1; shift ;;
      --detach)             detach=1; shift ;;
      -*)                   usage; exit 2 ;;
      *)                    name="$1"; shift ;;
    esac
  done

  if [[ -n $setup_op ]]; then
    load_setup_from_op "$setup_op"
  fi

  if [[ -z $name ]]; then
    usage
    exit 2
  fi

  validate_name "$name"

  # With a Tailscale auth key but no explicit hostname, name the node after the
  # host and the box (dhh-fd-bokka-bc3) so an unattended bring-up is identifiable.
  if [[ -n $ts_token && -z $tailscale_host ]]; then
    tailscale_host="$(host_ts_hostname "$name")"
  fi

  # A hostname can't register a fresh node on its own — Tailscale needs an auth
  # key. Fail here with a clear message instead of a container that exits during
  # setup when omaterm-setup-tailscale can't bring the node up.
  if [[ -n $tailscale_host && -z $ts_token ]]; then
    echo "Error: --ts-host needs --ts-token (a new Omaterm registers a fresh Tailscale node)." >&2
    exit 2
  fi

  if container_exists "$name"; then
    echo "Omaterm already exists: $name" >&2
    exit 1
  fi

  if [[ -n $template ]]; then
    validate_name "$template"
    image="$TEMPLATE_IMAGE_REPO:$template"
    docker image inspect "$image" >/dev/null 2>&1 || {
      echo "No such template: $template" >&2
      echo "Create one first: omaterm template create $template --from SOURCE" >&2
      echo "List templates with: omaterm template ls" >&2
      exit 1
    }
  else
    image="$IMAGE"
  fi

  name_args=(--name "$name")
  label_args=(--label "$LABEL")

  if (( no_limits )); then
    # Opt out of the limits game: run uncapped, tag the container so future
    # rebalances skip it, and re-divide only the existing limited Omaterms (this
    # one doesn't change their share). rebalance leaves LIMIT_ARGS set for the
    # last box it touched, so clear it before this Omaterm's own launch.
    label_args+=(--label "$NOLIMITS_LABEL")
    mapfile -t limited < <(omaterm_limited_names)
    rebalance_limits "${limited[@]}"
    LIMIT_ARGS=()
  else
    # Adding this Omaterm re-slices CPU and shrinks every limited Omaterm's
    # memory share. Build the limited set plus this one, re-divide the existing
    # ones, then claim this Omaterm's own slice by its position in the set.
    mapfile -t all < <(omaterm_limited_names; echo "$name")
    mapfile -t all < <(printf '%s\n' "${all[@]}" | sort -u)
    for i in "${!all[@]}"; do
      [[ ${all[i]} == "$name" ]] && new_index="$i"
    done
    rebalance_limits "${all[@]}"
    build_limit_args "${#all[@]}" "$new_index"
  fi

  # Attached boxes run interactively (-it) and hold the container open with a
  # login shell. A detached box (-d) has no terminal to attach to, so it idles
  # as PID 1 (OMATERM_DETACH, honored by the entrypoint) and is driven entirely
  # through `omaterm exec`. omaterm itself stays generic: it just makes a box
  # that stays up — what runs inside is the caller's business.
  run_mode=(-it)
  detach_env=()
  if (( detach )); then
    run_mode=(-d)
    detach_env=(-e OMATERM_DETACH=1)
  fi

  # An attached box needs a real terminal on stdin — docker run -it refuses a
  # pipe. When stdin isn't one (the curl|bash installer hands its pipe down),
  # rebind to the controlling terminal. Probe by opening: -r passes even when
  # there is no controlling terminal, and a failed exec redirect is fatal.
  if (( ! detach )) && ! [ -t 0 ] && { : </dev/tty; } 2>/dev/null; then
    exec </dev/tty
  fi

  if (( mount_docker )); then
    docker_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
  fi

  # A template image bakes in the source's setup env (tokens), so pass every
  # setup var explicitly — empty unless overridden — to keep the baked-in
  # values from silently re-applying. A fresh image only needs the values
  # actually provided.
  for pair in \
    OMATERM_SETUP_TS_HOST:tailscale_host \
    OMATERM_SETUP_GIT_NAME:git_name \
    OMATERM_SETUP_GIT_EMAIL:git_email \
    OMATERM_SETUP_GH_TOKEN:gh_token \
    OMATERM_SETUP_TS_AUTH_KEY:ts_token \
    OMATERM_SETUP_OP_TOKEN:op_token \
    OMATERM_SETUP_SSH_KEY:ssh_key; do
    var="${pair#*:}"

    if [[ -n $template || -n ${!var} ]]; then
      env_args+=(-e "${pair%%:*}=${!var}")
    fi
  done

  image_run=("$image")

  if [[ -n $template ]]; then
    # Every box stamped from a template is its own machine: wipe the Tailscale
    # state and clear the setup marker so it registers a fresh Tailscale node
    # (not fight the source over one identity) and re-runs setup to apply its
    # own --ts-host/token.
    image_run=(--entrypoint bash "$image"
      -c "rm -f $TAILSCALE_STATE_FILE $TAILSCALE_HOSTNAME_FILE $SETUP_DONE_MARKER; exec /home/omaterm/.local/bin/omaterm-entrypoint")
  fi

  exec docker run "${run_mode[@]}" "${detach_env[@]}" "${env_args[@]}" \
    "${name_args[@]}" \
    "${label_args[@]}" \
    --net host \
    "${LIMIT_ARGS[@]}" \
    "${docker_args[@]}" \
    "${image_run[@]}"
}

connect_omaterm() {
  local name="$1"

  if container_detached "$name"; then
    container_running "$name" || docker start "$name" >/dev/null
    exec docker exec -it "$name" bash -l
  fi

  if container_running "$name"; then
    exec docker attach "$name"
  else
    exec docker start -ai "$name"
  fi
}

run_connect() {
  local name="${1:-}" names limited

  if [[ -n $name ]]; then
    validate_name "$name"
    omaterm_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }
  else
    mapfile -t names < <(omaterm_names)

    # run_new execs into docker run, so it never returns here.
    if ((${#names[@]} == 0)); then
      run_new "$DEFAULT_NAME" -d
    fi

    name="$(choose_omaterm "Start" "${names[@]}")"
  fi

  mapfile -t limited < <(omaterm_limited_names)
  rebalance_limits "${limited[@]}"

  connect_omaterm "$name"
}

run_ls() {
  local names name state mem_bytes mem
  mapfile -t names < <(omaterm_names)
  ((${#names[@]})) || return 0

  {
    printf 'NAME\tSTATUS\tMEMORY\n'
    for name in "${names[@]}"; do
      state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo '?')"

      mem_bytes="$(docker inspect -f '{{.HostConfig.Memory}}' "$name" 2>/dev/null || echo 0)"
      if [[ $mem_bytes =~ ^[0-9]+$ ]] && ((mem_bytes > 0)); then
        mem="$((mem_bytes / 1024 / 1024))m"
      else
        mem="unlimited"
      fi

      printf '%s\t%s\t%s\n' "$name" "$state" "$mem"
    done
  } | column -t -s "$(printf '\t')"
}

run_exec() {
  local name="$1" command workdir="" docker_args=()
  shift

  validate_name "$name"
  omaterm_exists "$name" || {
    echo "No such Omaterm: $name" >&2
    exit 1
  }

  while (($#)); do
    case "$1" in
      -w | --workdir)
        [[ -n ${2:-} ]] || {
          usage
          exit 2
        }
        workdir="${2:-}"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  (($#)) || {
    usage
    exit 2
  }

  command="$*"
  [[ -n $workdir ]] && docker_args+=(-w "$workdir")

  if ! container_running "$name"; then
    docker start "$name" >/dev/null
  fi

  exec docker exec "${docker_args[@]}" "$name" bash -lc "$command"
}

# Reclaim dangling (untagged) images left behind by replaced templates or
# rebuilt base images. Only touches images no container references, so live
# Omaterms, templates, and their base images are safe.
prune_dangling_images() {
  docker image prune -f >/dev/null 2>&1 || true
}

run_rm() {
  local names name="${1:-}"

  if [[ $name == "-a" ]]; then
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    docker rm -f "${names[@]}"
    prune_dangling_images
    return
  elif [[ -n $name ]]; then
    validate_name "$name"
    omaterm_exists "$name" || {
      echo "No such Omaterm: $name" >&2
      exit 1
    }
  else
    mapfile -t names < <(omaterm_names)

    if ((${#names[@]} == 0)); then
      echo "No Omaterm containers found." >&2
      exit 1
    fi

    name="$(choose_omaterm "Remove" "${names[@]}")"
  fi

  docker rm -f "$name"
  prune_dangling_images

  # One fewer Omaterm means a larger CPU slice and memory share for the rest.
  mapfile -t names < <(omaterm_limited_names)
  rebalance_limits "${names[@]}"
}

ensure_docker_group "$@"

case "${1:-}" in
  "")       run_connect ;;
  new)      run_new "${@:2}" ;;
  template) run_template "${@:2}" ;;
  connect)  run_connect "${2:-}" ;;
  ls)       run_ls ;;
  exec)     run_exec "${@:2}" ;;
  rm)       run_rm "${2:-}" ;;
  -h)       usage ;;
  *)
    usage
    exit 2
    ;;
esac
