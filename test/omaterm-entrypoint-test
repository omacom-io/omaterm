#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENTRYPOINT="$ROOT/bin/omaterm-entrypoint"

fail() {
  echo "not ok - $1" >&2
  exit 1
}

pass() {
  echo "ok - $1"
}

line_of() {
  local file="$1" pattern="$2"
  grep -nxF "$pattern" "$file" | head -n1 | cut -d: -f1
}

grep -qF 'NOPASSWD: /usr/bin/tailscale' "$ENTRYPOINT" ||
  fail "entrypoint should temporarily grant passwordless sudo only for tailscale"

grep -qF 'rm -f "$TAILSCALE_SUDOERS"' "$ENTRYPOINT" ||
  fail "entrypoint should remove the temporary tailscale sudoers rule after setup"

grep -qF 'start_tailscaled' "$ENTRYPOINT" ||
  fail "entrypoint should start tailscaled before setup"

setup_line="$(grep -nF '/home/omaterm/.local/bin/omaterm-setup' "$ENTRYPOINT" | tail -n1 | cut -d: -f1)"
grant_line="$(line_of "$ENTRYPOINT" 'grant_tailscale_sudo')"
revoke_line="$(line_of "$ENTRYPOINT" 'revoke_tailscale_sudo')"
tailscaled_line="$(line_of "$ENTRYPOINT" 'start_tailscaled')"
handoff_line="$(grep -nF 'bash -l "$@"' "$ENTRYPOINT" | head -n1 | cut -d: -f1)"
[[ -n $setup_line && -n $handoff_line ]] && (( setup_line < handoff_line )) ||
  fail "entrypoint should run setup before shell handoff"

[[ -n $grant_line && -n $setup_line && -n $revoke_line && -n $handoff_line ]] &&
  (( grant_line < setup_line && setup_line < revoke_line && revoke_line < handoff_line )) ||
  fail "entrypoint should only keep tailscale sudoers around setup"

[[ -n $tailscaled_line && -n $setup_line ]] && (( tailscaled_line < setup_line )) ||
  fail "entrypoint should start tailscaled before setup"

grep -qF 'runuser -u omaterm -- env "${SETUP_ENV[@]}"' "$ENTRYPOINT" ||
  fail "entrypoint should run setup as omaterm"

grep -qF 'exec runuser -u omaterm -- env "${OMATERM_ENV[@]}" bash -l "$@"' "$ENTRYPOINT" ||
  fail "entrypoint should hand off to login bash as omaterm"

grep -qF 'TERM="${TERM:-xterm-256color}"' "$ENTRYPOINT" ||
  fail "entrypoint should default missing TERM to xterm-256color"

pass "entrypoint tailscale and shell handoff contracts"
