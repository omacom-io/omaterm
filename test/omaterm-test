  assert_file_contains "$TEST_TMP/docker-actions" "run -it --name omaterm --label omaterm=1 --net host --cpuset-cpus 2-19 --cpu-shares 1024 --memory 61440m --memory-swap 61440m -v /var/run/docker.sock:/var/run/docker.sock omaterm:test" "host reserve is configurable"
