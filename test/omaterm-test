  assert_file_not_contains "$TEST_TMP/docker-actions" "--cpuset-cpus" "no-limits omits cpuset"
  assert_file_not_contains "$TEST_TMP/docker-actions" "--memory" "no-limits omits memory cap"
  assert_file_contains "$TEST_TMP/docker-actions" "run -it --name omaterm --label omaterm=1 --net host -v /var/run/docker.sock:/var/run/docker.sock omaterm:test" "no-limits runs without resource flags"
  pass "no-limits opts out"
}

