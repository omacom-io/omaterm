test_oversubscribed_shares_full_cpuset() {
  new_env
  write_docker
  printf 'omaterm:false:1\nomaterm2:false:1\n' >"$TEST_CONTAINERS"

  # 3 Omaterms but only 2 non-reserved cores: no per-box slice fits, so every
  # Omaterm is pinned to the full range 1-2 (not left unpinned) and cpu-shares
  # arbitrates. The full pin is reapplied on rebalance, overwriting any prior
  # narrow slice. (65536 - 2048) / 3 = 21162 MB each.
  OMATERM_TOTAL_CORES=3 run_omaterm new omaterm3

  assert_file_contains "$TEST_TMP/docker-actions" "run -it --name omaterm3 --label omaterm=1 --net host --cpuset-cpus 1-2 --cpu-shares 1024 --memory 21162m --memory-swap 21162m omaterm:test" "oversubscribed new pins to the full non-reserved range"
  assert_file_contains "$TEST_TMP/docker-actions" "update --cpuset-cpus 1-2 --cpu-shares 1024 --memory 21162m --memory-swap 21162m omaterm" "oversubscribed rebalance re-pins existing to the full range"
  pass "oversubscribed shares full cpuset"
}

