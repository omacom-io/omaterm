#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT="$ROOT/bin/host/omaterm"

# shellcheck source=test/helpers
source "$(dirname "${BASH_SOURCE[0]}")/helpers"

new_env() {
  TEST_TMP="$(mktemp -d)"
  TEST_BIN="$TEST_TMP/bin"
  TEST_CONTAINERS="$TEST_TMP/containers"
  TEST_IMAGES="$TEST_TMP/images"
  mkdir -p "$TEST_BIN"
  : >"$TEST_CONTAINERS"
  : >"$TEST_IMAGES"
  export TEST_TMP TEST_CONTAINERS TEST_IMAGES
}

write_docker() {
  cat >"$TEST_BIN/docker" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

container_exists() {
  local wanted="$1" name running label nolimits detached
  while IFS=: read -r name running label nolimits detached; do
    [[ $name == "$wanted" ]] && return 0
  done <"$TEST_CONTAINERS"
  return 1
}

container_running() {
  local wanted="$1" name running label nolimits detached
  while IFS=: read -r name running label nolimits detached; do
    if [[ $name == "$wanted" ]]; then
      [[ $running == "true" ]] && return 0 || return 1
    fi
  done <"$TEST_CONTAINERS"
  return 1
}

if [[ ${1:-} == "container" && ${2:-} == "ls" ]]; then
  # TEST_CONTAINERS rows are name:running:label[:nolimits]. A request that
  # filters on the nolimits label lists only the tagged opt-outs.
  want_nolimits=0
  [[ "$*" == *omaterm.nolimits* ]] && want_nolimits=1
  while IFS=: read -r name running label nolimits; do
    [[ -n $name && $label == "1" ]] || continue
    if ((want_nolimits)); then
      [[ $nolimits == "1" ]] && printf '%s\n' "$name"
    else
      printf '%s\n' "$name"
    fi
  done <"$TEST_CONTAINERS"
  exit 0
fi

if [[ ${1:-} == "container" && ${2:-} == "inspect" ]]; then
  container_exists "${3:-}" && exit 0 || exit 1
fi

if [[ ${1:-} == "inspect" && ${2:-} == "-f" ]]; then
  if [[ ${3:-} == *".State.Running"* ]]; then
    if container_running "${4:-}"; then
      echo true
    else
      echo false
    fi
  elif [[ ${3:-} == *".Config.Env"* ]]; then
    while IFS=: read -r name running label nolimits detached; do
      if [[ $name == "${4:-}" && $detached == "1" ]]; then
        echo "OMATERM_DETACH=1"
        break
      fi
    done <"$TEST_CONTAINERS"
  fi
  exit 0
fi

# Template images live in TEST_IMAGES, one "repo:tag" per line.
if [[ ${1:-} == "image" && ${2:-} == "inspect" ]]; then
  grep -qxF "${3:-}" "$TEST_IMAGES" 2>/dev/null && exit 0 || exit 1
fi

if [[ ${1:-} == "image" && ${2:-} == "ls" ]]; then
  while IFS= read -r ref; do
    [[ $ref == "${3:-}":* ]] && printf '%s\t%s\t%s\n' "${ref#*:}" "100MB" "1 minute ago"
  done <"$TEST_IMAGES" 2>/dev/null
  exit 0
fi

if [[ ${1:-} == "info" && ${TEST_DOCKER_INFO_FAIL:-0} == "1" && ${TEST_IN_SG:-0} != "1" ]]; then
  echo "permission denied while trying to connect to the docker API at unix:///var/run/docker.sock" >&2
  exit 1
fi

# Record the action, then reconcile container/image state so later reads reflect it.
printf '%s\n' "$*" >>"$TEST_TMP/docker-actions"

if [[ ${1:-} == "rm" ]]; then
  shift
  [[ ${1:-} == "-f" ]] && shift
  for target in "$@"; do
    grep -v "^$target:" "$TEST_CONTAINERS" >"$TEST_CONTAINERS.tmp" 2>/dev/null || true
    mv "$TEST_CONTAINERS.tmp" "$TEST_CONTAINERS"
  done
fi

if [[ ${1:-} == "commit" ]]; then
  printf '%s\n' "${3:-}" >>"$TEST_IMAGES"
fi

if [[ ${1:-} == "image" && ${2:-} == "rm" ]]; then
  grep -vxF "${3:-}" "$TEST_IMAGES" >"$TEST_IMAGES.tmp" 2>/dev/null || true
  mv "$TEST_IMAGES.tmp" "$TEST_IMAGES"
fi

exit 0
SH
  chmod +x "$TEST_BIN/docker"

  # Fixed host hostname so derived Tailscale names are deterministic in tests.
  cat >"$TEST_BIN/hostname" <<'SH'
#!/usr/bin/env bash
printf 'testhost\n'
SH
  chmod +x "$TEST_BIN/hostname"
}

write_gum() {
  cat >"$TEST_BIN/gum" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
printf '%s\n' "$TEST_GUM_CHOICE"
SH
  chmod +x "$TEST_BIN/gum"
}

write_op() {
  cat >"$TEST_BIN/op" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"$TEST_TMP/op-calls"

if [[ "$*" == "item get Omaterm Setup --format json" || "$*" == "item get Omaterm Setup --vault Personal --format json" ]]; then
  cat <<'JSON'
{
  "fields": [
    { "label": "git-name", "value": "Op User" },
    { "section": { "label": "add more" }, "label": "git-email", "value": "op@example.com" },
    { "section": { "label": "add more" }, "label": "gh-token", "value": "ghp_op" },
    { "section": { "label": "add more" }, "label": "ts-token", "value": "tskey-op" },
    { "section": { "label": "add more" }, "label": "ts-host", "value": "op-host" },
    { "section": { "label": "add more" }, "label": "op-token", "value": "ops_op" },
    { "section": { "label": "add more" }, "label": "ssh-key", "value": "ssh-ed25519 OPKEY op" }
  ]
}
JSON
  exit 0
fi

exit 1
SH
  chmod +x "$TEST_BIN/op"
}

write_fresh_docker_group_membership() {
  cat >"$TEST_BIN/id" <<'SH'
#!/usr/bin/env bash
case "${1:-}" in
  -G)
    if [[ ${TEST_IN_SG:-0} == "1" ]]; then
      printf '1000 999\n'
    else
      printf '1000\n'
    fi
    ;;
  -nG) printf 'dhh\n' ;;
  -un) printf 'dhh\n' ;;
  *)   /usr/bin/id "$@" ;;
esac
SH
  chmod +x "$TEST_BIN/id"

  cat >"$TEST_BIN/getent" <<'SH'
#!/usr/bin/env bash
if [[ ${1:-} == "group" && ${2:-} == "docker" ]]; then
  printf 'docker:x:999:dhh\n'
elif [[ ${1:-} == "passwd" && ${2:-} == "dhh" ]]; then
  printf 'dhh:x:1000:1000:DHH:/home/dhh:/bin/bash\n'
else
  /usr/bin/getent "$@"
fi
SH
  chmod +x "$TEST_BIN/getent"

cat >"$TEST_BIN/sg" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/sg-calls"
[[ ${1:-} == "docker" && ${2:-} == "-c" ]] || exit 1
TEST_IN_SG=1 bash -c "${3:-}"
SH
  chmod +x "$TEST_BIN/sg"
}

run_omaterm() {
  PATH="$TEST_BIN:$PATH" OMATERM_IMAGE="omaterm:test" \
    OMATERM_TOTAL_CORES="${OMATERM_TOTAL_CORES:-20}" \
    OMATERM_TOTAL_RAM_MB="${OMATERM_TOTAL_RAM_MB:-65536}" \
    "$SCRIPT" "$@" >"$TEST_TMP/output" 2>&1
}

# With 20 cores / 65536 MB and the 1-core / 2048 MB host reserve, a lone
# Omaterm is pinned to cores 1-19 and capped at (65536 - 2048) MB.
LIMITS_ONE="--cpuset-cpus 1-19 --cpu-shares 1024 --memory 63488m --memory-swap 63488m"

test_help_lists_commands() {
  new_env
  write_docker

  run_omaterm -h

  assert_file_contains "$TEST_TMP/output" "omaterm new NAME [-t|--template TEMPLATE] [-d|--docker-access]" "help lists new"
  assert_file_not_contains "$TEST_TMP/output" "--prepare" "help does not list prepare"
  assert_file_contains "$TEST_TMP/output" "omaterm template create NAME --from SOURCE" "help lists template create"
  assert_file_contains "$TEST_TMP/output" "omaterm template ls" "help lists template ls"
  assert_file_contains "$TEST_TMP/output" "omaterm template rm NAME" "help lists template rm"
  assert_file_contains "$TEST_TMP/output" "omaterm connect [NAME]" "help lists connect"
  assert_file_contains "$TEST_TMP/output" "omaterm exec NAME [-w|--workdir DIR] COMMAND..." "help lists exec workdir"
  pass "help lists commands"
}

test_fresh_docker_group_runs_with_sg() {
