test_no_limits_box_excluded_from_rebalance() {
  new_env
  write_docker
  # An existing limited box and an existing no-limits box (4th field = nolimits).
  printf 'omaterm:false:1\nsandbox:false:1:1\n' >"$TEST_CONTAINERS"

  run_omaterm new omaterm2

  # Only the two limited boxes divide resources → 1-10, 11-19 and
  # (65536 - 2048) / 2 = 31744 MB. The no-limits box is never touched.
  assert_file_contains "$TEST_TMP/docker-actions" "run -it --name omaterm2 --label omaterm=1 --net host --cpuset-cpus 11-19 --cpu-shares 1024 --memory 31744m --memory-swap 31744m omaterm:test" "limited new divides only among limited boxes"
  assert_file_contains "$TEST_TMP/docker-actions" "update --cpuset-cpus 1-10 --cpu-shares 1024 --memory 31744m --memory-swap 31744m omaterm" "existing limited box is re-sliced for two"
  assert_file_not_contains "$TEST_TMP/docker-actions" "sandbox" "no-limits box is never rebalanced"
  pass "no-limits box excluded from rebalance"
}

