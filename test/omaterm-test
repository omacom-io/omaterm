  assert_file_contains "$TEST_TMP/sg-calls" "new bokka-bc3 -d" "sg re-exec preserves omaterm arguments"
  assert_file_contains "$TEST_TMP/docker-actions" "run -it --name bokka-bc3" "re-exec runs the requested omaterm command"
  pass "fresh docker group membership runs immediately"
}

