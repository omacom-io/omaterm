test_new_rebalances_existing() {
  new_env
  write_docker
  printf 'omaterm:false:1\nomaterm2:false:1\n' >"$TEST_CONTAINERS"

  run_omaterm new omaterm3

  # 19 shared cores split 3 ways → 1-7, 8-13, 14-19 (earlier Omaterms absorb the
  # remainder). (65536 - 2048) / 3 Omaterms = 21162 MB each.
  assert_file_contains "$TEST_TMP/docker-actions" "run -it --name omaterm3 --label omaterm=1 --net host --cpuset-cpus 14-19 --cpu-shares 1024 --memory 21162m --memory-swap 21162m omaterm:test" "new claims its own CPU slice and divided memory"
  assert_file_contains "$TEST_TMP/docker-actions" "update --cpuset-cpus 1-7 --cpu-shares 1024 --memory 21162m --memory-swap 21162m omaterm" "new re-slices the first existing Omaterm"
  assert_file_contains "$TEST_TMP/docker-actions" "update --cpuset-cpus 8-13 --cpu-shares 1024 --memory 21162m --memory-swap 21162m omaterm2" "new re-slices the second existing Omaterm"
  pass "new rebalances existing"
}

test_rm_rebalances_remaining() {
  new_env
  write_docker
  printf 'omaterm:false:1\nomaterm2:false:1\nomaterm3:false:1\n' >"$TEST_CONTAINERS"

  run_omaterm rm omaterm3

  # Survivors split 19 cores → 1-10, 11-19 and (65536 - 2048) / 2 = 31744 MB each.
  assert_file_contains "$TEST_TMP/docker-actions" "update --cpuset-cpus 1-10 --cpu-shares 1024 --memory 31744m --memory-swap 31744m omaterm" "rm regrows the first survivor's slice"
  assert_file_contains "$TEST_TMP/docker-actions" "update --cpuset-cpus 11-19 --cpu-shares 1024 --memory 31744m --memory-swap 31744m omaterm2" "rm regrows the second survivor's slice"
  pass "rm rebalances remaining"
}

