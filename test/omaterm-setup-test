  [[ ! -s "$TEST_TMP/gum-calls" ]] || fail "missing tailscale env token should not prompt"
  assert_file_contains "$TEST_TMP/gitconfig" "name=Token User" "missing tailscale env token configures git"
  assert_equals "ghp_token" "$(cat "$TEST_TMP/gh-token")" "missing tailscale env token logs into gh"
