#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT="$ROOT/bin/omaterm-setup"

fail() {
  echo "not ok - $1" >&2
  exit 1
}

pass() {
  echo "ok - $1"
}

assert_file_contains() {
  local file="$1" expected="$2" label="$3"
  if ! grep -qF -- "$expected" "$file"; then
    echo "--- $file ---" >&2
    cat "$file" >&2 2>/dev/null || true
    fail "$label"
  fi
}

assert_file_not_contains() {
  local file="$1" unexpected="$2" label="$3"
  [[ ! -e "$file" ]] || ! grep -qF -- "$unexpected" "$file" || fail "$label"
}

assert_equals() {
  local expected="$1" actual="$2" label="$3"
  [[ "$actual" == "$expected" ]] || fail "$label: expected '$expected', got '$actual'"
}

new_env() {
  TEST_TMP="$(mktemp -d)"
  TEST_HOME="$TEST_TMP/home"
  TEST_BIN="$TEST_TMP/bin"
  mkdir -p "$TEST_HOME" "$TEST_BIN"
  export TEST_TMP TEST_HOME
}

write_common_fakes() {
  cat >"$TEST_BIN/git" <<'SH'
#!/usr/bin/env bash
config="$TEST_TMP/gitconfig"
if [[ "$1 $2" == "config --global" ]]; then
  case "${3:-}" in
    user.name)
      if [[ $# -eq 3 ]]; then
        value="$(sed -n 's/^name=//p' "$config" 2>/dev/null | tail -n1)"
        [[ -n "$value" ]] || exit 1
        printf '%s\n' "$value"
      else
        mkdir -p "$(dirname "$config")"
        sed -i '/^name=/d' "$config" 2>/dev/null || true
        printf 'name=%s\n' "$4" >>"$config"
      fi
      ;;
    user.email)
      if [[ $# -eq 3 ]]; then
        value="$(sed -n 's/^email=//p' "$config" 2>/dev/null | tail -n1)"
        [[ -n "$value" ]] || exit 1
        printf '%s\n' "$value"
      else
        mkdir -p "$(dirname "$config")"
        sed -i '/^email=/d' "$config" 2>/dev/null || true
        printf 'email=%s\n' "$4" >>"$config"
      fi
      ;;
  esac
  exit 0
fi
exit 0
SH

  cat >"$TEST_BIN/gh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gh-calls"
case "$1 $2" in
  "auth status") exit 1 ;;
  "auth login") cat >"$TEST_TMP/gh-token" ;;
  *) exit 0 ;;
esac
SH

  cat >"$TEST_BIN/tailscale" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/tailscale-calls"
if [[ "${1:-}" == "status" ]]; then
  exit 1
fi
exit 0
SH

  cat >"$TEST_BIN/tailscaled" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/tailscaled-calls"
exit 0
SH

  cat >"$TEST_BIN/sudo" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/sudo-calls"
case "${1:-}" in
  -n)
    shift
    if [[ "${1:-}" == "tailscale" ]]; then
      shift
      exec tailscale "$@"
    fi
    exit 0
    ;;
  tailscale) shift; exec tailscale "$@" ;;
  sh|mkdir|rm) exit 0 ;;
  *) exit 0 ;;
esac
SH

  cat >"$TEST_BIN/op" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/op-calls"
case "$1 ${2:-}" in
  "whoami ")
    [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]] && exit 0
    exit 1
    ;;
  "account list")
    printf '[]\n'
    ;;
  "account add")
    cat >"$TEST_TMP/op-password"
    printf 'export OP_SESSION_test=session\n'
    ;;
  "signin ")
    cat >"$TEST_TMP/op-password"
    printf 'export OP_SESSION_test=session\n'
    ;;
  *) exit 0 ;;
esac
SH

  chmod +x "$TEST_BIN"/*
}

write_gum() {
  cat >"$TEST_BIN/gum"
  chmod +x "$TEST_BIN/gum"
}

run_setup() {
  local status

  set +e
  HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    "$SCRIPT" >"$TEST_TMP/output" 2>&1
  status=$?
  set -e

  if [[ "$status" -ne 0 ]]; then
    cat "$TEST_TMP/output" >&2
    fail "omaterm-setup exited with status $status"
  fi
}

test_env_seed_unattended() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
exit 99
SH

  OMATERM_SETUP_GIT_NAME="Seed User" \
    OMATERM_SETUP_GIT_EMAIL="seed@example.com" \
    OMATERM_SETUP_GH_TOKEN="ghp_seed" \
    OMATERM_SETUP_TS_AUTH_KEY="tskey-seed" \
    OMATERM_SETUP_TS_HOST="seed-host" \
    OMATERM_SETUP_OP_TOKEN="ops_seed" \
    OMATERM_SETUP_SSH_KEY="ssh-ed25519 SEEDKEY seed" \
    HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    "$SCRIPT" >"$TEST_TMP/output" 2>&1

  [[ ! -s "$TEST_TMP/gum-calls" ]] || fail "env seed should not prompt"
  assert_file_contains "$TEST_TMP/gitconfig" "name=Seed User" "env seed configures git name"
  assert_file_contains "$TEST_TMP/gitconfig" "email=seed@example.com" "env seed configures git email"
  assert_equals "ghp_seed" "$(cat "$TEST_TMP/gh-token")" "env seed logs into gh"
  assert_file_contains "$TEST_TMP/tailscale-calls" "up --ssh --accept-routes --hostname=seed-host --auth-key=tskey-seed" "env seed brings up tailscale"
  assert_equals "ssh-ed25519 SEEDKEY seed" "$(cat "$TEST_HOME/.ssh/authorized_keys")" "env seed installs ssh key"
  assert_file_contains "$TEST_TMP/output" "✓ 1Password" "env seed applies 1password token"
  assert_file_not_contains "$TEST_TMP/output" "Setup complete" "unattended env seed skips final wait"
  pass "env seed is unattended"
}

test_env_seed_does_not_prompt_for_missing_tailscale_hostname() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
exit 99
SH

  OMATERM_SETUP_TS_AUTH_KEY="tskey-seed" \
    HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    "$SCRIPT" >"$TEST_TMP/output" 2>&1

  [[ ! -s "$TEST_TMP/gum-calls" ]] || fail "env seed without hostname should not prompt"
  [[ ! -e "$TEST_TMP/tailscale-calls" ]] || ! grep -qF "up --ssh" "$TEST_TMP/tailscale-calls" || fail "env seed without hostname should not run tailscale up"
  pass "env seed skips partial tailscale data"
}

test_env_seed_failure_does_not_fall_back_to_interactive_setup() {
  local status

  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
exit 0
SH

  cat >"$TEST_BIN/omaterm-setup-github" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/setup-github-calls"
exit 2
SH
  chmod +x "$TEST_BIN/omaterm-setup-github"

  set +e
  OMATERM_SETUP_GH_TOKEN="ghp_seed" \
    HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    "$SCRIPT" >"$TEST_TMP/output" 2>&1
  status=$?
  set -e

  [[ "$status" -ne 0 ]] || fail "failing env seed should fail setup"
  assert_file_contains "$TEST_TMP/setup-github-calls" "--token ghp_seed" "env seed calls seeded helper"
  [[ ! -s "$TEST_TMP/gum-calls" ]] || fail "failing env seed should not prompt"
  [[ ! -f "$TEST_HOME/.local/state/omaterm/setup-done" ]] || fail "failing env seed should not write setup marker"
  pass "env seed failure does not fall back to interactive setup"
}

test_ctrl_c_skips_setup() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "${1:-}" in
  confirm) exit 130 ;;
  input) exit 130 ;;
  spin) echo "spin" >>"$TEST_TMP/spin-calls"; exit 0 ;;
  *) exit 0 ;;
esac
SH

  run_setup

  [[ -f "$TEST_HOME/.local/state/omaterm/setup-done" ]] || fail "ctrl-c writes setup marker"
  assert_file_not_contains "$TEST_TMP/gum-calls" "Authenticate with GitHub?" "ctrl-c skips later questions"
  assert_file_contains "$TEST_TMP/output" "Setup complete" "ctrl-c finishes setup"
  pass "ctrl-c skips setup"
}

