test_1password_full_account_token_excludes_password() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "$1" in
  confirm)
    if [[ "$*" == "confirm Authenticate with 1Password?" ]]; then
      exit 0
    elif [[ "$*" == "confirm Copy setup token to clipboard? --default=false" ]]; then
      exit 0
    fi
    exit 1
    ;;
  choose) printf 'Use full account details\n' ;;
  input)
    case "$*" in
      *"1Password sign-in address"*) printf 'my.1password.com\n' ;;
      *"1Password email"*) printf 'me@example.com\n' ;;
      *"1Password secret key"*) printf 'A3-SECRET\n' ;;
      *"1Password account shorthand"*) printf 'my\n' ;;
      *"1Password password"*) printf 'super-secret-password\n' ;;
      *) printf '\n' ;;
    esac
    ;;
  spin) exit 130 ;;
  *) exit 0 ;;
esac
SH

  HOME="$TEST_HOME" PATH="$TEST_BIN:$ROOT/bin:$PATH" OMATERM_DOCKER=1 script -qfec "$SCRIPT" "$TEST_TMP/typescript" >/dev/null 2>&1 || true

  assert_file_contains "$TEST_TMP/op-calls" "account add --address my.1password.com --email me@example.com --secret-key A3-SECRET --signin --shorthand my" "full account path adds account with details"
  assert_equals "super-secret-password" "$(cat "$TEST_TMP/op-password")" "full account password is piped to op"
  osc52_token="$(perl -0ne 'print "$1\n" if /\e\]52;c;([A-Za-z0-9+\/=]+)\a/s' "$TEST_TMP/typescript" | tail -n1)"
  [[ -n $osc52_token ]] || fail "setup token is copied with OSC 52"
  token="$(printf '%s' "$osc52_token" | base64 -d)"
  decoded="$(printf '%s' "$token" | base64 -d)"
  printf '%s' "$decoded" | jq -e '.onepassword.account.address == "my.1password.com" and .onepassword.account.email == "me@example.com" and .onepassword.account.secret_key == "A3-SECRET" and .onepassword.account.shorthand == "my"' >/dev/null || fail "full account details are included in setup token"
  ! printf '%s' "$decoded" | grep -q 'super-secret-password' || fail "full account password must not be included in setup token"
  pass "1Password full account token excludes password"
}

test_setup_token_copy_has_osc52_fallback() {
  grep -qF 'printf '\''\033]52;c;%s\a'\''' "$SCRIPT" ||
