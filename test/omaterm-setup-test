test_env_token_interactive_does_not_copy_token() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "${1:-}" in
  confirm) exit 0 ;;
  spin) exit 0 ;;
  *) exit 99 ;;
esac
SH

  OMATERM_SETUP_TOKEN="$(setup_token_without_tailscale)" \
    HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    OMATERM_DOCKER=1 \
    script -qfec "$SCRIPT" "$TEST_TMP/typescript" >/dev/null 2>&1

  [[ -f "$TEST_HOME/.local/state/omaterm/setup-done" ]] || fail "interactive env token writes setup marker"
  assert_file_not_contains "$TEST_TMP/gum-calls" "Copy setup token" "interactive env token does not offer to copy a new token"
  assert_file_not_contains "$TEST_TMP/typescript" $'\033]52;c;' "interactive env token does not copy a new token"
  pass "interactive env token does not copy setup token"
}

test_ctrl_c_skips_setup() {
  new_env
  write_common_fakes
  write_gum <<'SH'
