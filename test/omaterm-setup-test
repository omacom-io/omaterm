test_ctrl_c_after_manual_progress_finishes_setup() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
count_file="$TEST_TMP/gum-count"
count="$(cat "$count_file" 2>/dev/null || echo 0)"
count=$((count + 1))
echo "$count" >"$count_file"
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "$1:$count" in
  confirm:1) exit 0 ;;
  input:2) printf 'Manual User\n' ;;
  input:3) exit 1 ;;
  spin:*) echo "spin" >>"$TEST_TMP/spin-calls"; exit 0 ;;
  *) exit 1 ;;
esac
SH

  run_setup

  [[ -f "$TEST_HOME/.local/state/omaterm/setup-done" ]] || fail "ctrl-c after manual progress writes setup marker"
  assert_file_not_contains "$TEST_TMP/gum-calls" "Authenticate with GitHub?" "ctrl-c after manual progress skips later questions"
  pass "ctrl-c after manual progress finishes setup"
}

