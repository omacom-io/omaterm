test_ssh_key_only_writes_authorized_keys() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "$1" in
  confirm)
    [[ "$*" == "confirm Add SSH public key for remote access?" ]] && exit 0
    exit 1
    ;;
  input) printf 'ssh-ed25519 AAAATEST test\n' ;;
  spin) exit 0 ;;
  *) exit 0 ;;
esac
SH

  run_setup

  assert_equals "ssh-ed25519 AAAATEST test" "$(cat "$TEST_HOME/.ssh/authorized_keys")" "ssh key is written to authorized_keys"
  assert_file_not_contains "$TEST_TMP/output" "authorized_keys" "ssh setup does not print authorized_keys chatter"
  assert_file_not_contains "$TEST_TMP/output" "ssh-keygen" "ssh setup does not generate host keys"
  assert_file_not_contains "$TEST_TMP/sudo-calls" "sshd" "ssh setup does not touch sshd"
  assert_file_contains "$TEST_TMP/output" "✓ SSH" "manual ssh setup delegates to helper"
  pass "ssh setup only writes authorized_keys"
}

test_1password_service_token_path() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "$1" in
  confirm)
    [[ "$*" == "confirm Authenticate with 1Password?" ]] && exit 0
    exit 1
    ;;
  choose) printf 'Use service token\n' ;;
  input) printf 'ops_service\n' ;;
  spin) exit 0 ;;
  *) exit 0 ;;
esac
SH

  run_setup

  assert_file_contains "$TEST_TMP/gum-calls" "choose --header Choose 1password authentication Use service token Use full account details" "1password service path uses gum choose with header"
  assert_file_not_contains "$TEST_TMP/gum-calls" "select" "1password service path does not use unsupported gum select"
  assert_file_contains "$TEST_TMP/output" "✓ 1Password" "main setup delegates to omaterm-setup-1password"
  assert_file_contains "$TEST_TMP/output" "✓ 1Password" "1password service token authenticates"
  assert_file_not_contains "$TEST_TMP/op-calls" "account add" "service token path does not add account"
  pass "1Password service token path"
}

test_1password_full_account_path() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "$1" in
  confirm)
    [[ "$*" == "confirm Authenticate with 1Password?" ]] && exit 0
    exit 1
    ;;
  choose) printf 'Use full account details\n' ;;
  input)
    case "$*" in
      *"1Password sign-in address"*) printf 'my.1password.com\n' ;;
      *"1Password email"*) printf 'me@example.com\n' ;;
      *"1Password secret key"*) printf 'A3-SECRET\n' ;;
      *"1Password account shorthand"*) printf 'my\n' ;;
      *"1Password password"*) printf 'super-secret-password\n' ;;
      *) printf '\n' ;;
    esac
    ;;
  spin) exit 130 ;;
  *) exit 0 ;;
esac
SH

  HOME="$TEST_HOME" PATH="$TEST_BIN:$ROOT/bin:$PATH" script -qfec "$SCRIPT" "$TEST_TMP/typescript" >/dev/null 2>&1 || true

  assert_file_contains "$TEST_TMP/op-calls" "account add --address my.1password.com --email me@example.com --secret-key A3-SECRET --signin --shorthand my" "full account path adds account with details"
  assert_equals "super-secret-password" "$(cat "$TEST_TMP/op-password")" "full account password is piped to op"
  assert_file_not_contains "$TEST_TMP/typescript" $'\033]52;c;' "full account path does not copy setup data"
  pass "1Password full account path"
}

main() {
  test_env_seed_unattended
  test_env_seed_does_not_prompt_for_missing_tailscale_hostname
  test_env_seed_failure_does_not_fall_back_to_interactive_setup
  test_ctrl_c_skips_setup
  test_confirm_interrupt_status_skips_setup
  test_ctrl_c_after_manual_progress_finishes_setup
  test_ctrl_c_after_tailscale_hostname_finishes_setup
  test_git_manual_uses_helper
  test_tailscale_manual_requires_auth_key_and_no_sudo_for_hostname
  test_github_manual_uses_helper
  test_ssh_key_only_writes_authorized_keys
  test_1password_service_token_path
  test_1password_full_account_path
}

main "$@"
