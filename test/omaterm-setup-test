#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT="$ROOT/bin/omaterm-setup"

fail() {
  echo "not ok - $1" >&2
  exit 1
}

pass() {
  echo "ok - $1"
}

assert_file_contains() {
  local file="$1" expected="$2" label="$3"
  if ! grep -qF -- "$expected" "$file"; then
    echo "--- $file ---" >&2
    cat "$file" >&2 2>/dev/null || true
    fail "$label"
  fi
}

assert_file_not_contains() {
  local file="$1" unexpected="$2" label="$3"
  [[ ! -e "$file" ]] || ! grep -qF -- "$unexpected" "$file" || fail "$label"
}

assert_equals() {
  local expected="$1" actual="$2" label="$3"
  [[ "$actual" == "$expected" ]] || fail "$label: expected '$expected', got '$actual'"
}

new_env() {
  TEST_TMP="$(mktemp -d)"
  TEST_HOME="$TEST_TMP/home"
  TEST_BIN="$TEST_TMP/bin"
  mkdir -p "$TEST_HOME" "$TEST_BIN"
  export TEST_TMP TEST_HOME
}

write_common_fakes() {
  cat >"$TEST_BIN/git" <<'SH'
#!/usr/bin/env bash
config="$TEST_TMP/gitconfig"
if [[ "$1 $2" == "config --global" ]]; then
  case "${3:-}" in
    user.name)
      if [[ $# -eq 3 ]]; then
        value="$(sed -n 's/^name=//p' "$config" 2>/dev/null | tail -n1)"
        [[ -n "$value" ]] || exit 1
        printf '%s\n' "$value"
      else
        mkdir -p "$(dirname "$config")"
        sed -i '/^name=/d' "$config" 2>/dev/null || true
        printf 'name=%s\n' "$4" >>"$config"
      fi
      ;;
    user.email)
      if [[ $# -eq 3 ]]; then
        value="$(sed -n 's/^email=//p' "$config" 2>/dev/null | tail -n1)"
        [[ -n "$value" ]] || exit 1
        printf '%s\n' "$value"
      else
        mkdir -p "$(dirname "$config")"
        sed -i '/^email=/d' "$config" 2>/dev/null || true
        printf 'email=%s\n' "$4" >>"$config"
      fi
      ;;
  esac
  exit 0
fi
exit 0
SH

  cat >"$TEST_BIN/gh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gh-calls"
case "$1 $2" in
  "auth status") exit 1 ;;
  "auth login") cat >"$TEST_TMP/gh-token" ;;
  *) exit 0 ;;
esac
SH

  cat >"$TEST_BIN/tailscale" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/tailscale-calls"
if [[ "${1:-}" == "status" ]]; then
  exit 1
fi
exit 0
SH

  cat >"$TEST_BIN/tailscaled" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/tailscaled-calls"
exit 0
SH

  cat >"$TEST_BIN/sudo" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/sudo-calls"
case "${1:-}" in
  -n)
    shift
    if [[ "${1:-}" == "tailscale" ]]; then
      shift
      exec tailscale "$@"
    fi
    exit 0
    ;;
  tailscale) shift; exec tailscale "$@" ;;
  sh|mkdir|rm) exit 0 ;;
  *) exit 0 ;;
esac
SH

  cat >"$TEST_BIN/op" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/op-calls"
case "$1 ${2:-}" in
  "whoami ")
    [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]] && exit 0
    exit 1
    ;;
  "account list")
    printf '[]\n'
    ;;
  "account add")
    cat >"$TEST_TMP/op-password"
    printf 'export OP_SESSION_test=session\n'
    ;;
  "signin ")
    cat >"$TEST_TMP/op-password"
    printf 'export OP_SESSION_test=session\n'
    ;;
  *) exit 0 ;;
esac
SH

  cat >"$TEST_BIN/systemctl" <<'SH'
#!/usr/bin/env bash
exit 1
SH

  chmod +x "$TEST_BIN"/*
}

write_gum() {
  cat >"$TEST_BIN/gum"
  chmod +x "$TEST_BIN/gum"
}

setup_token() {
  jq -cn \
    --arg git_name "Token User" \
    --arg git_email "token@example.com" \
    --arg gh_token "ghp_token" \
    --arg ts_auth_key "tskey-token" \
    --arg ssh_key "ssh-ed25519 TOKENKEY token" \
    --arg op_token "ops_token" \
    '{
      git: {name: $git_name, email: $git_email},
      github: {token: $gh_token},
      tailscale: {auth_key: $ts_auth_key},
      ssh: {public_key: $ssh_key},
      onepassword: {token: $op_token}
    }' | base64 -w0
}

setup_token_without_tailscale() {
  jq -cn \
    --arg git_name "Token User" \
    --arg git_email "token@example.com" \
    --arg gh_token "ghp_token" \
    --arg ssh_key "ssh-ed25519 TOKENKEY token" \
    --arg op_token "ops_token" \
    '{
      git: {name: $git_name, email: $git_email},
      github: {token: $gh_token},
      ssh: {public_key: $ssh_key},
      onepassword: {token: $op_token}
    }' | base64 -w0
}

run_setup() {
  local status

  set +e
  HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    OMATERM_DOCKER=1 \
    "$SCRIPT" >"$TEST_TMP/output" 2>&1
  status=$?
  set -e

  if [[ "$status" -ne 0 ]]; then
    cat "$TEST_TMP/output" >&2
    fail "omaterm-setup exited with status $status"
  fi
}

test_env_token_unattended() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
exit 99
SH

  OMATERM_SETUP_TOKEN="$(setup_token)" \
    OMATERM_TS_HOSTNAME="token-host" \
    HOME="$TEST_HOME" \
    PATH="$TEST_BIN:$ROOT/bin:$PATH" \
    OMATERM_DOCKER=1 \
    "$SCRIPT" >"$TEST_TMP/output" 2>&1

  [[ ! -s "$TEST_TMP/gum-calls" ]] || fail "env token should not prompt"
  assert_file_contains "$TEST_TMP/gitconfig" "name=Token User" "env token configures git name"
  assert_file_contains "$TEST_TMP/gitconfig" "email=token@example.com" "env token configures git email"
  assert_file_contains "$TEST_TMP/output" "✓ Git" "env token delegates git setup"
  assert_equals "ghp_token" "$(cat "$TEST_TMP/gh-token")" "env token logs into gh"
  assert_file_contains "$TEST_TMP/output" "✓ GitHub" "env token delegates github setup"
  assert_file_contains "$TEST_TMP/sudo-calls" "-n tailscale up --ssh --accept-routes --hostname=token-host --auth-key=tskey-token" "env token uses non-interactive sudo for docker tailscale"
  assert_file_contains "$TEST_TMP/tailscale-calls" "up --ssh --accept-routes --hostname=token-host --auth-key=tskey-token" "env token brings up tailscale with provided hostname"
  assert_equals "token-host" "$(cat "$TEST_HOME/.local/state/omaterm/tailscale-hostname")" "tailscale hostname stored in user state"
  assert_equals "ssh-ed25519 TOKENKEY token" "$(cat "$TEST_HOME/.ssh/authorized_keys")" "env token installs ssh key"
  assert_file_contains "$TEST_TMP/output" "✓ SSH" "env token delegates ssh setup"
  assert_file_contains "$TEST_TMP/output" "✓ 1Password" "env token applies service token"
  assert_file_not_contains "$TEST_TMP/output" "Setup complete" "unattended env token skips final wait"
  pass "env token with OMATERM_TS_HOSTNAME is unattended"
}

