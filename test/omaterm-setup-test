test_tailscale_manual_requires_auth_key_and_no_sudo_for_hostname() {
  new_env
  write_common_fakes
  write_gum <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$TEST_TMP/gum-calls"
case "$1" in
  confirm)
    [[ "$*" == "confirm Connect to Tailscale?" ]] && exit 0
    exit 1
    ;;
  input)
    case "$*" in
      *"Tailnet hostname"*) printf 'manual-host\n' ;;
      *"Tailscale auth key"*) printf 'tskey-manual\n' ;;
      *) printf '\n' ;;
    esac
    ;;
  spin) exit 0 ;;
  *) exit 0 ;;
esac
SH

  run_setup

  assert_file_contains "$TEST_TMP/gum-calls" "Tailscale auth key" "tailscale auth key is required"
  assert_file_contains "$TEST_TMP/sudo-calls" "-n tailscale up --ssh --accept-routes --hostname=manual-host --auth-key=tskey-manual" "manual tailscale uses non-interactive sudo"
  assert_file_contains "$TEST_TMP/tailscale-calls" "up --ssh --accept-routes --hostname=manual-host --auth-key=tskey-manual" "manual tailscale uses auth key"
  assert_equals "manual-host" "$(cat "$TEST_HOME/.local/state/omaterm/tailscale-hostname")" "manual tailscale hostname stored in user state"
  assert_file_not_contains "$TEST_TMP/sudo-calls" "tee" "tailscale hostname storage does not use sudo"
  pass "manual tailscale requires auth key and stores hostname without sudo"
}

